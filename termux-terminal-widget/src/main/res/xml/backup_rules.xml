<?xml version="1.0" encoding="utf-8"?>
<!--
  Full backup content for API &lt; 31. Prefer data_extraction_rules.xml on 12+.
  Keep shared prefs only; never include external storage or app files.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="device.xml"/>
</full-backup-content>
