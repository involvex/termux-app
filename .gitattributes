*           text=auto
*.bat       text eol=crlf
*.gradle    text eol=lf
*.mk        text eol=lf
*.sh        text eol=lf
# Container seed tree: executed inside Linux containers, and the helpers use
# '#!@BASH@' shebangs that seed.sh rewrites. CRLF would turn into
# "bad interpreter" / "not found" inside the image, so force LF on checkout
# even on Windows (core.autocrlf=true would otherwise rewrite these files).
docker/**        text eol=lf
# Container seed tree is now shipped as app assets (shell scripts with #!@BASH@
# shebangs resolved at install time). CRLF would break them inside the image.
app/src/main/assets/invapp/**      text eol=lf
