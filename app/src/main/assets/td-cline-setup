#!/data/data/com.involvex.termux_app/files/usr/bin/bash
# invapp-resource: td-cline-setup
# Cline CLI installer for InVxTermux
# Downloads @cline/cli-linux-arm64 from npm registry.
# Uses glibc + DNS shim via ld-linux (mirrors opencode-setup pattern).
# IMPORTANT: patches ELF interpreter with patchelf so daemon subprocess works.
set -e
PREFIX="${PREFIX:-/data/data/com.involvex.termux_app/files/usr}"
HOME="${HOME:-/data/data/com.involvex.termux_app/files/home}"
export PATH="$PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMPDIR"
REDIRECTOR_SO="$PREFIX/lib/libinvapp-redirector.so"
[ -f "$REDIRECTOR_SO" ] && export LD_PRELOAD="$REDIRECTOR_SO${LD_PRELOAD:+:$LD_PRELOAD}"

CLINE_DIR="$PREFIX/libexec/cline"
CLINE_BIN="$CLINE_DIR/cline"
CLINE_VERSION_FILE="$PREFIX/var/lib/invapp/cline.version"

# Load commons if available
if [ -f "$PREFIX/lib/invapp/bootstrap.sh" ] && [ -f "$PREFIX/lib/invapp/commons.sh" ]; then
  . "$PREFIX/lib/invapp/bootstrap.sh"
  import "@/commons"
else
  D_CYAN=$'\e[0;36m'
  D_GREEN=$'\e[0;32m'
  D_RED=$'\e[0;31m'
  D_YELLOW=$'\e[0;33m'
  D_NC=$'\e[0;37m'
  GRAY=$'\e[0;90m'
  GREEN=$'\e[1;32m'
  CYAN=$'\e[1;36m'
  RED=$'\e[1;31m'
  YELLOW=$'\e[1;33m'
  NC=$'\e[1;37m'
  log_info()    { echo -e "    ${CYAN}>>${D_CYAN} $*${D_NC}"; }
  log_success() { echo -e "    ${GREEN}OK${D_GREEN} $*${D_NC}"; }
  log_warn()    { echo -e "    ${YELLOW}!!${D_YELLOW} $*${D_NC}"; }
  log_error()   { echo -e "    ${RED}ERR${D_RED} $*${D_NC}" >&2; }
  list_item()   { echo -e "    ${GRAY}*${D_NC} $*"; }
  box() { echo -e "${GRAY}== $1 ==${NC}"; }
  loading() { "$@"; }
fi

_arch_tag() {
  case "$(uname -m)" in
    aarch64|arm64) echo "arm64" ;;
    x86_64|amd64)  echo "x64"   ;;
    *)             echo "arm64" ;;
  esac
}

_glibc_loader() {
  local arch="$(_arch_tag)"
  if [ "$arch" = "x64" ]; then
    echo "$PREFIX/glibc/lib/ld-linux-x86-64.so.2"
  else
    echo "$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
  fi
}

_needs_glibc() {
  [ ! -f "$PREFIX/glibc/lib/libc.so.6" ]
}

_install_glibc() {
  log_info "Installing glibc (linux binaries need it on Android)"
  yes | pkg install glibc-repo 2>&1 | tail -1
  yes | pkg install glibc 2>&1 | tail -1
  log_success "glibc installed"
}

_get_latest_cline_version() {
  curl -fsSL "https://registry.npmjs.org/@cline%2fcli-linux-arm64/latest" 2>/dev/null |
    sed -n 's/.*\"version\":\"\([^\"]*\)\".*/\1/p' | head -1
}

_install_cline_native() {
  if _needs_glibc; then
    _install_glibc || exit 1
  fi

  if ! command -v patchelf >/dev/null 2>&1; then
    log_info "Installing patchelf"
    yes | pkg install patchelf 2>&1 | tail -1 || {
      log_error "patchelf required to fix ELF interpreter"
      return 1
    }
  fi

  local ver="${CLINE_VERSION:-}"
  if [ -z "$ver" ]; then
    ver="$(_get_latest_cline_version)"
    if [ -z "$ver" ]; then
      log_error "Could not fetch latest Cline version"
      return 1
    fi
  fi
  log_info "Cline version: $ver"

  local arch="$(_arch_tag)"
  local npmpkg
  case "$arch" in
    arm64) npmpkg="@cline/cli-linux-arm64" ;;
    x64)   npmpkg="@cline/cli-linux-x64" ;;
    *)     npmpkg="@cline/cli-linux-arm64" ;;
  esac

  log_info "Downloading Cline CLI from npm registry"
  rm -rf "$CLINE_DIR.tmp"
  mkdir -p "$CLINE_DIR.tmp"
  local tgz="$TMPDIR/cline-cli.tgz"
  curl -fsSL "https://registry.npmjs.org/$npmpkg/-/cli-linux-${arch}-${ver}.tgz" -o "$tgz"

  tar -xzf "$tgz" -C "$CLINE_DIR.tmp" 2>/dev/null
  rm -f "$tgz"

  local found=""
  if [ -f "$CLINE_DIR.tmp/package/bin/cline" ]; then
    found="$CLINE_DIR.tmp/package/bin/cline"
  elif [ -f "$CLINE_DIR.tmp/bin/cline" ]; then
    found="$CLINE_DIR.tmp/bin/cline"
  else
    found=$(find "$CLINE_DIR.tmp" -type f -name 'cline' 2>/dev/null | head -1)
  fi

  if [ -z "$found" ]; then
    log_error "Tarball did not contain cline binary"
    rm -rf "$CLINE_DIR.tmp"
    return 1
  fi

  rm -rf "$CLINE_DIR"
  mkdir -p "$CLINE_DIR"
  cp "$found" "$CLINE_BIN"
  chmod +x "$CLINE_BIN"
  rm -rf "$CLINE_DIR.tmp"

  # Patch ELF interpreter to glibc loader.
  # Cline's --cline-hub-daemon subprocess re-execs the binary directly
  # (without the wrapper), so the ELF interpreter must point to the
  # glibc loader. Do NOT use --set-rpath (corrupts the binary).
  local ld="$(_glibc_loader)"
  if [ -f "$ld" ]; then
    log_info "Patching ELF interpreter to $ld"
    patchelf --set-interpreter "$ld" "$CLINE_BIN" 2>&1 || {
      log_warn "patchelf failed - Cline daemon subprocess may fail"
      log_info "Run: pkill -f cline  # kill stale daemon before retry"
    }
  fi

  # Kill stale Cline daemons (started before wrapper existed)
  pkill -f "cline" 2>/dev/null || true

  mkdir -p "$(dirname "$CLINE_VERSION_FILE")"
  echo "$ver" > "$CLINE_VERSION_FILE"

  log_success "Cline CLI installed"
  echo
  list_item "Version:  $ver"
  list_item "Binary:   $CLINE_BIN"
  list_item "Command:  cline"
  echo
}

CLINE_VERSION=""
FORCE_REINSTALL=0

echo ""
box "Cline CLI Setup"
echo

while [ $# -gt 0 ]; do
  case "$1" in
    --version) CLINE_VERSION="${2:-}"; shift 2 ;;
    --version=*) CLINE_VERSION="${1#--version=}"; shift ;;
    --reinstall) FORCE_REINSTALL=1; shift ;;
    -h|--help)
      echo "Usage: td-cline-setup [--version V] [--reinstall]"
      echo "  --version V   Pin version (default: latest npm)"
      echo "  --reinstall   Force reinstall"
      exit 0 ;;
    *) echo "Unknown: $1" >&2; exit 2 ;;
  esac
done

if [ "$FORCE_REINSTALL" -eq 0 ] && [ -x "$CLINE_BIN" ]; then
  log_success "Cline CLI already installed"
  list_item "Binary: $CLINE_BIN"
  if [ -f "$CLINE_VERSION_FILE" ]; then
    list_item "Version: $(cat "$CLINE_VERSION_FILE")"
  fi
  list_item "Run: cline --help"
  exit 0
fi

if _needs_glibc; then
  log_warn "glibc not installed (required)"
  log_info "Run: pkg install glibc"
  exit 1
fi

_install_cline_native
echo
log_info "Done. Run: cline"
echo
