#!/data/data/com.involvex.termux_app/files/usr/bin/bash
# invapp-resource: kilo
# Runtime wrapper for KiloCode CLI - glibc ld-linux + DNS shim
PREFIX="${PREFIX:-/data/data/com.involvex.termux_app/files/usr}"
KILOCODE_BIN="$PREFIX/libexec/kilocode/kilo"

case "$(uname -m)" in
  aarch64|arm64) OC_LD="ld-linux-aarch64.so.1" ;;
  x86_64|amd64)  OC_LD="ld-linux-x86-64.so.2"   ;;
  *)             OC_LD="ld-linux-aarch64.so.1" ;;
esac

LD_LOADER="$PREFIX/glibc/lib/$OC_LD"
LIB="$PREFIX/glibc/lib"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMPDIR" 2>/dev/null || true

if [ ! -x "$KILOCODE_BIN" ]; then
  echo "kilo: binary missing - run td-kilo-setup" >&2
  exit 127
fi
if [ ! -x "$LD_LOADER" ]; then
  echo "kilo: glibc missing - run td-kilo-setup" >&2
  exit 127
fi

# Keep LD_PRELOAD empty so termux-exec does NOT reinject Bionic
# libinvapp-redirector.so (that causes version LIBC not found).
# Load DNS shim via ld-linux --preload instead.
export LD_PRELOAD=
OC_SHIM="$PREFIX/lib/libinvapp-opencode-shim.so"
OC_PRELOAD_ARGS=""
if [ -f "$OC_SHIM" ]; then
  OC_PRELOAD_ARGS="--preload $OC_SHIM"
elif [ -f "$PREFIX/lib/libinvapp-getifaddrs.so" ]; then
  OC_PRELOAD_ARGS="--preload $PREFIX/lib/libinvapp-getifaddrs.so"
fi

exec "$LD_LOADER" $OC_PRELOAD_ARGS --library-path "$LIB" "$KILOCODE_BIN" "$@"
