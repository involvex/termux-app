#!/system/bin/sh
# invapp-container: td-ai task shortcut
# Parity with the app's ~/.shortcuts/tasks/td-ai widget.
#
# Starts the OpenCode service on :4000 (opencode-server / td-ai).
set -u

PORT="${1:-4000}"

if command -v opencode-server >/dev/null 2>&1; then
    exec opencode-server "$PORT"
fi
if command -v td-ai >/dev/null 2>&1; then
    exec td-ai "$PORT"
fi
echo "opencode-server / td-ai missing" >&2
exit 127
