#!@BASH@
# InVxTermux — cursor-agent-setup (glibc Node 24; never Bun / curl|bash).
set -e
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"
INVAPP_FILES_DIR="${PREFIX%/usr}"
_stock_files="$(printf '%s' 'L2RhdGEvZGF0YS9jb20udGVybXV4L2ZpbGVz' | base64 -d 2>/dev/null || true)"
_stock_pkg="$(printf '%s' 'Y29tLnRlcm11eA==' | base64 -d 2>/dev/null || true)"

WRAP_ONLY=0
for arg in "$@"; do
  case "$arg" in --wrap-only) WRAP_ONLY=1 ;; esac
done
case "$(uname -m)" in
  aarch64|arm64) CA_ARCH=arm64; CA_LD=ld-linux-aarch64.so.1 ;;
  x86_64|amd64)  CA_ARCH=x64;   CA_LD=ld-linux-x86-64.so.2 ;;
  *) echo "cursor-agent-setup: unsupported arch $(uname -m)" >&2; exit 1 ;;
esac
CA_ROOT="$HOME/.local/share/cursor-agent"
CA_VERSIONS="$CA_ROOT/versions"
fixup_glibc_paths() {
  local f
  for f in "$PREFIX/opt/glibc-runner/glibc-runner.sh" "$PREFIX/bin/grun"; do
    [ -f "$f" ] || continue
    grep -q "${_stock_pkg}" "$f" 2>/dev/null || continue
    sed -i "s|${_stock_files}|${INVAPP_FILES_DIR}|g" "$f" 2>/dev/null || true
  done
  if [ -f "$PREFIX/glibc/lib/libc.so.6" ]; then
    ln -sfn libc.so.6 "$PREFIX/glibc/lib/libc.so" 2>/dev/null || true
  fi
  ln -sfn libdl.so.2 "$PREFIX/glibc/lib/libdl.so" 2>/dev/null || true
  ln -sfn libpthread.so.0 "$PREFIX/glibc/lib/libpthread.so" 2>/dev/null || true
  mkdir -p "$PREFIX/etc" "$PREFIX/glibc/etc/ssl/certs"
  if [ ! -s "$PREFIX/etc/resolv.conf" ]; then
    printf '%s\n' 'nameserver 8.8.8.8' 'nameserver 1.1.1.1' > "$PREFIX/etc/resolv.conf"
  fi
  cp -f "$PREFIX/etc/resolv.conf" "$PREFIX/glibc/etc/resolv.conf" 2>/dev/null || true
  printf '%s\n' '127.0.0.1 localhost' '::1 localhost' | tee \
    "$PREFIX/etc/hosts" "$PREFIX/glibc/etc/hosts" >/dev/null
  if [ -f "$PREFIX/etc/tls/cert.pem" ]; then
    ln -sfn "$PREFIX/etc/tls/cert.pem" \
      "$PREFIX/glibc/etc/ssl/certs/ca-certificates.crt" 2>/dev/null || true
  fi
}
ensure_glibc() {
  if [ -x "$PREFIX/glibc/lib/$CA_LD" ]; then
    fixup_glibc_paths
    return 0
  fi
  echo "cursor-agent-setup: installing glibc…"
  mkdir -p "$PREFIX/etc/apt/sources.list.d"
  printf '%s\n' \
    'deb [trusted=yes] https://packages-cf.termux.dev/apt/termux-glibc/ glibc stable' \
    > "$PREFIX/etc/apt/sources.list.d/glibc.list"
  export DEBIAN_FRONTEND=noninteractive
  pkg install -y glibc-repo 2>/dev/null || true
  apt-get update -y 2>/dev/null || pkg update -y 2>/dev/null || true
  pkg install -y glibc glibc-runner openssl-glibc ca-certificates 2>/dev/null \
    || apt-get install -y glibc glibc-runner openssl-glibc ca-certificates 2>/dev/null \
    || true
  [ -x "$PREFIX/glibc/lib/$CA_LD" ] || return 1
  fixup_glibc_paths
  return 0
}
if ! ensure_glibc; then
  echo "cursor-agent-setup: glibc missing — pkg install glibc-repo glibc" >&2
  exit 1
fi
if ! strings "$PREFIX/glibc/lib/libc.so.6" 2>/dev/null | grep -q 'GLIBC_2\.34'; then
  echo "cursor-agent-setup: glibc may be < 2.34 (pty.node needs GLIBC_2.34)" >&2
  echo "  Try: pkg upgrade -y glibc" >&2
fi
resolve_version() {
  if [ -n "${CURSOR_AGENT_VERSION:-}" ]; then
    echo "$CURSOR_AGENT_VERSION"
    return
  fi
  local v
  v=$(curl -fsSL --max-time 30 https://cursor.com/install 2>/dev/null \
    | grep -oE '[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[a-f0-9]+' | head -1)
  if [ -n "$v" ]; then echo "$v"; return; fi
  echo "2026.09.26-dd393fe"
}
find_version_dir() {
  if [ -L "$CA_ROOT/current" ] || [ -d "$CA_ROOT/current" ]; then
    local c
    c=$(readlink -f "$CA_ROOT/current" 2>/dev/null || echo "$CA_ROOT/current")
    if [ -x "$c/node" ] && [ -f "$c/index.js" ]; then echo "$c"; return; fi
  fi
  if [ -f "$CA_ROOT/version" ]; then
    local pinned
    pinned=$(tr -d '[:space:]' < "$CA_ROOT/version")
    if [ -x "$CA_VERSIONS/$pinned/node" ]; then echo "$CA_VERSIONS/$pinned"; return; fi
  fi
  local d
  for d in "$CA_VERSIONS"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    if [ -x "$d/node" ] && [ -f "$d/index.js" ]; then echo "$d"; return; fi
  done
}
install_complete() {
  local d="$1"
  [ -x "$d/node" ] && [ -f "$d/index.js" ] || return 1
  [ -f "$d/node_modules/tree-sitter/package.json" ] || return 1
  [ -f "$d/node_modules/tree-sitter/index.js" ] || return 1
  [ -f "$d/node_modules/tree-sitter/build/Release/tree_sitter_runtime_binding.node" ] || return 1
  [ -f "$d/node_modules/tree-sitter-bash/package.json" ] || return 1
  [ -f "$d/node_modules/tree-sitter-bash/bindings/node/index.js" ] || return 1
  [ -f "$d/node_modules/tree-sitter-bash/build/Release/tree_sitter_bash_binding.node" ] || return 1
  [ -f "$d/node_modules/node-gyp-build/package.json" ] || return 1
  return 0
}
write_wrappers() {
  local WRAPPER="$PREFIX/bin/agent"
  cat > "$WRAPPER" <<EOF
#!$PREFIX/bin/bash
# invapp-cursor-agent-wrapper — bundled Node via glibc ld-linux (not Bun)
PREFIX="$PREFIX"
HOME="$HOME"
CA_LD="$CA_LD"
CA_ROOT="\$HOME/.local/share/cursor-agent"
CA_VERSIONS="\$CA_ROOT/versions"
find_dir() {
  if [ -L "\$CA_ROOT/current" ] || [ -d "\$CA_ROOT/current" ]; then
    local c; c=\$(readlink -f "\$CA_ROOT/current" 2>/dev/null || echo "\$CA_ROOT/current")
    if [ -x "\$c/node" ] && [ -f "\$c/index.js" ]; then echo "\$c"; return; fi
  fi
  if [ -f "\$CA_ROOT/version" ]; then
    local p; p=\$(tr -d '[:space:]' < "\$CA_ROOT/version")
    if [ -x "\$CA_VERSIONS/\$p/node" ]; then echo "\$CA_VERSIONS/\$p"; return; fi
  fi
  local d
  for d in "\$CA_VERSIONS"/*/; do
    [ -d "\$d" ] || continue
    d=\${d%/}
    if [ -x "\$d/node" ] && [ -f "\$d/index.js" ]; then echo "\$d"; return; fi
  done
}
VERSION_DIR=\$(find_dir)
if [ -z "\$VERSION_DIR" ]; then
  echo "agent: not installed — run cursor-agent-setup" >&2
  exit 127
fi
NODE_BIN="\$VERSION_DIR/node"
INDEX_JS="\$VERSION_DIR/index.js"
LD="\$PREFIX/glibc/lib/\$CA_LD"
LIB="\$PREFIX/glibc/lib"
if [ ! -x "\$LD" ]; then
  echo "agent: glibc missing — run cursor-agent-setup" >&2
  exit 127
fi
export LD_PRELOAD=
export LD_LIBRARY_PATH=
export TMPDIR="\${TMPDIR:-\$PREFIX/tmp}"
mkdir -p "\$TMPDIR" 2>/dev/null || true
CA_SHIM="\$PREFIX/lib/libinvapp-opencode-shim.so"
CA_PRELOAD_ARGS=
if [ -f "\$CA_SHIM" ]; then
  CA_PRELOAD_ARGS="--preload \$CA_SHIM"
fi
mkdir -p "\$PREFIX/glibc/etc/ssl/certs" 2>/dev/null || true
if [ ! -s "\$PREFIX/etc/resolv.conf" ]; then
  printf '%s\n' 'nameserver 8.8.8.8' 'nameserver 1.1.1.1' > "\$PREFIX/etc/resolv.conf"
fi
cp -f "\$PREFIX/etc/resolv.conf" "\$PREFIX/glibc/etc/resolv.conf" 2>/dev/null || true
if [ -f "\$PREFIX/etc/tls/cert.pem" ]; then
  export SSL_CERT_FILE="\$PREFIX/etc/tls/cert.pem"
  export CURL_CA_BUNDLE="\$PREFIX/etc/tls/cert.pem"
  export NODE_EXTRA_CA_CERTS="\$PREFIX/etc/tls/cert.pem"
  mkdir -p "\$PREFIX/etc/tls/certs" "\$PREFIX/glibc/etc/ssl/certs" 2>/dev/null || true
  ln -sfn "\$PREFIX/etc/tls/cert.pem" \
    "\$PREFIX/etc/tls/certs/ca-certificates.crt" 2>/dev/null || true
  ln -sfn "\$PREFIX/etc/tls/cert.pem" \
    "\$PREFIX/glibc/etc/ssl/certs/ca-certificates.crt" 2>/dev/null || true
  export SSL_CERT_DIR="\$PREFIX/etc/tls/certs"
fi
export PATH="\$PREFIX/bin:\$PATH"
# shellcheck disable=SC2086
exec -a "\$0" "\$LD" --library-path "\$LIB" \$CA_PRELOAD_ARGS \
  "\$NODE_BIN" --use-system-ca "\$INDEX_JS" "\$@"
EOF
  chmod 700 "$WRAPPER"
  cp -f "$WRAPPER" "$PREFIX/bin/cursor-agent"
  chmod 700 "$PREFIX/bin/cursor-agent"
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$WRAPPER" "$HOME/.local/bin/agent" 2>/dev/null || true
  ln -sfn "$WRAPPER" "$HOME/.local/bin/cursor-agent" 2>/dev/null || true
}
if [ "$WRAP_ONLY" = 1 ]; then
  CA_FOUND=$(find_version_dir)
  if [ -z "$CA_FOUND" ]; then
    echo "cursor-agent-setup --wrap-only: no install under $CA_VERSIONS — full setup" >&2
    WRAP_ONLY=0
  elif ! install_complete "$CA_FOUND"; then
    echo "cursor-agent-setup --wrap-only: incomplete (missing tree-sitter) — full re-extract" >&2
    rm -rf "$CA_FOUND"
    WRAP_ONLY=0
  else
    write_wrappers
    echo "OK: rewrote $PREFIX/bin/agent → $CA_FOUND"
    exit 0
  fi
fi
CA_VER=$(resolve_version)
CA_DIR="$CA_VERSIONS/$CA_VER"
CA_URL="https://downloads.cursor.com/lab/$CA_VER/linux/$CA_ARCH/agent-cli-package.tar.gz"
NEED_DL=1
if install_complete "$CA_DIR"; then
  echo "cursor-agent-setup: $CA_VER already present"
  NEED_DL=0
elif [ -x "$CA_DIR/node" ] || [ -f "$CA_DIR/index.js" ]; then
  echo "cursor-agent-setup: incomplete install (missing tree-sitter) — re-extracting…"
  rm -rf "$CA_DIR"
fi
if [ "$NEED_DL" = 1 ]; then
  echo "Downloading Cursor Agent CLI $CA_VER ($CA_ARCH)…"
  echo "  $CA_URL"
  echo "  (~173 MiB; never use Bun or curl|bash under Android)"
  mkdir -p "$CA_DIR.new" "$CA_VERSIONS"
  CA_TAR="$TMPDIR/agent-cli-package.tar.gz"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 --retry-delay 2 -o "$CA_TAR" "$CA_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$CA_TAR" "$CA_URL"
  else
    echo "cursor-agent-setup: need curl or wget" >&2
    exit 127
  fi
  rm -rf "$CA_DIR.new"
  mkdir -p "$CA_DIR.new"
  tar -xzf "$CA_TAR" -C "$CA_DIR.new" --strip-components=1
  rm -f "$CA_TAR"
  if ! install_complete "$CA_DIR.new"; then
    echo "cursor-agent-setup: tarball incomplete (need node + tree-sitter node_modules)" >&2
    ls -la "$CA_DIR.new/node_modules/tree-sitter" 2>&1 || true
    rm -rf "$CA_DIR.new"
    exit 1
  fi
  chmod +x "$CA_DIR.new/node" "$CA_DIR.new/rg" 2>/dev/null || true
  rm -rf "$CA_DIR"
  mv "$CA_DIR.new" "$CA_DIR"
fi
printf '%s\n' "$CA_VER" > "$CA_ROOT/version"
ln -sfn "$CA_DIR" "$CA_ROOT/current" 2>/dev/null || true
if [ ! -f "$PREFIX/lib/libinvapp-opencode-shim.so" ]; then
  echo "cursor-agent-setup: DNS shim missing — reopen app or run opencode-setup" >&2
fi
write_wrappers
hash -r 2>/dev/null || true
export PATH="$PREFIX/bin:$PATH"
echo "cursor-agent-setup: probing agent --version…"
if ! agent --version 2>&1; then
  echo "cursor-agent-setup: wrapper failed under glibc" >&2
  echo "  Binary: $CA_DIR/node" >&2
  exit 1
fi
agent sandbox disable 2>/dev/null || true
echo "OK. Auth: agent login   (or CURSOR_API_KEY=…)"
echo "Worker (Cursor cloud My Machines): td-agent-worker start"
echo "Pin version: CURSOR_AGENT_VERSION=YYYY.MM.DD-hash cursor-agent-setup"
echo "After agent update: cursor-agent-setup --wrap-only"
