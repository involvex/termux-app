  cat > "$stub_map" <<'STUBMAP'
GLIBC_2.17 {
  global: getaddrinfo; gethostbyname; gethostbyname2; open; open64; openat; fopen; getifaddrs; freeifaddrs;
  local: *;
};
STUBMAP
  if "$cc" -shared -fPIC -O2 -ldl -Wl,--version-script="$stub_map" -o "$stub_so" "$stub_c" 2>/dev/null; then
    echo "opencode-setup: installed DNS/getifaddrs shim → $stub_so"
    rm -f "$PREFIX/lib/libinvapp-getifaddrs.so"
  else
    echo "opencode-setup: shim compile failed (need gcc-glibc)" >&2
    rm -f "$stub_so"
  fi
  rm -f "$stub_c" "$stub_map"
}
build_opencode_shim
rm -f "$HOME/.bun/bin/opencode" 2>/dev/null || true
cp -f "$WRAPPER" "$HOME/.bun/bin/opencode"
chmod 700 "$HOME/.bun/bin/opencode"
hash -r 2>/dev/null || true
export PATH="$PREFIX/bin:$HOME/.bun/bin:$PATH"
if ! head -1 "$WRAPPER" | grep -q bash; then
  echo "opencode-setup: wrapper write failed (still a bun symlink?)" >&2
  exit 1
fi
if ! command -v opencode >/dev/null 2>&1; then
  echo "opencode-setup: wrapper not on PATH" >&2
  exit 1
fi
echo "opencode-setup: probing opencode --version…"
if opencode --version 2>&1; then
  rm -rf "$HOME/.cache/opencode" 2>/dev/null || true
  case "$OC_VER" in 1.*|0.*)
    for pkg in "$HOME/.config/opencode/package.json" "$HOME/repos"/*/.opencode/package.json; do
      [ -f "$pkg" ] || continue
      if grep -q '@opencode-ai/plugin@local\|"@opencode-ai/plugin": "local"' "$pkg" 2>/dev/null; then
        echo "opencode-setup: fixing plugin@local in $pkg (V1 only)"
        sed -i 's/@opencode-ai\/plugin@local/@opencode-ai\/plugin@latest/g; s/"@opencode-ai\/plugin": "local"/"@opencode-ai\/plugin": "latest"/g' "$pkg" 2>/dev/null || true
      fi
    done
    ;;
  esac
  echo "OK (v$OC_VER)."
  echo "  Server: td-ai / opencode-server   # foreground serve 127.0.0.1:4000"
  echo "  TUI:    opencode                 # attaches to :4000, else --standalone"
  echo "  Preview → http://127.0.0.1:4000/  (LAN: OPENCODE_HOST=0.0.0.0)"
  OC_PW=$(sed -n 's/.*"password"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$HOME/.config/opencode/service.json" 2>/dev/null | head -1)
  if [ -n "$OC_PW" ]; then echo "Verify: curl -u opencode:$OC_PW http://127.0.0.1:4000/api/info (JSON, not HTML)"; fi
  echo "If chat fails with 'typo in the url or port': rm -rf ~/.cache/opencode && opencode-fix-net && td-ai"
else
  case "$(uname -m)" in x86_64|amd64)
    echo "opencode-setup: standard x64 binary failed — trying baseline (no AVX2)…" >&2
    OC_ASSET_BASE="${OC_ASSET%.tar.gz}-baseline.tar.gz"
    OC_URL_BASE="https://opencode.ai/files/bin/$OC_VER/$OC_ASSET_BASE"
    OC_TAR="$TMPDIR/$OC_ASSET_BASE"
    if curl -fL --retry 2 --retry-delay 2 -o "$OC_TAR" "$OC_URL_BASE" 2>/dev/null; then
      rm -rf "$OC_DIR.new"; mkdir -p "$OC_DIR.new"
      if tar -xzf "$OC_TAR" -C "$OC_DIR.new" 2>/dev/null; then
        FOUND=$(find "$OC_DIR.new" -type f -name opencode 2>/dev/null | head -1)
        if [ -n "$FOUND" ] && [ -f "$FOUND" ]; then
          chmod +x "$FOUND"; rm -rf "$OC_DIR"; mv "$OC_DIR.new" "$OC_DIR"
          OC_BIN=$(find "$OC_DIR" -type f -name opencode 2>/dev/null | head -1)
          sed -i "s|^OC_BIN=.*|OC_BIN=\"$OC_BIN\"|" "$WRAPPER" 2>/dev/null || true
          if opencode --version 2>&1; then
            echo "OK (v$OC_VER baseline). Run: td-ai" 
            rm -rf "$HOME/.cache/opencode" 2>/dev/null || true
            exit 0
          fi
        fi
      fi
    fi
    ;;
  esac
  echo "opencode-setup: wrapper installed but binary failed under glibc" >&2
  echo "Binary: $OC_BIN" >&2
  exit 1
fi
