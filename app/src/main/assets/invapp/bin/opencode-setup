#!@BASH@
# InVxTermux — opencode-setup (OpenCode V2 + glibc ld-linux wrapper).
set -e
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"
INVAPP_FILES_DIR="${PREFIX%/usr}"
_stock_files="$(printf '%s' 'L2RhdGEvZGF0YS9jb20udGVybXV4L2ZpbGVz' | base64 -d 2>/dev/null || true)"
_stock_pkg="$(printf '%s' 'Y29tLnRlcm11eA==' | base64 -d 2>/dev/null || true)"
REDIRECTOR_SO="$PREFIX/lib/libinvapp-redirector.so"
[ -f "$REDIRECTOR_SO" ] && export LD_PRELOAD="$REDIRECTOR_SO${LD_PRELOAD:+:$LD_PRELOAD}"

rm -f "$PREFIX/bin/opencode" "$HOME/.bun/bin/opencode" 2>/dev/null || true
rm -f "$PREFIX/bin/opencode-v2" "$PREFIX/bin/opencode-v2-server" \
  "$HOME/.bun/bin/opencode-v2" "$HOME/.bun/bin/opencode-v2-server" \
  "$HOME/.local/bin/opencode-v2" "$HOME/.local/bin/opencode-v2-server" 2>/dev/null || true
case "$(uname -m)" in
  aarch64|arm64) OC_ASSET=opencode-linux-arm64.tar.gz; OC_LD=ld-linux-aarch64.so.1 ;;
  x86_64|amd64)  OC_ASSET=opencode-linux-x64.tar.gz;  OC_LD=ld-linux-x86-64.so.2 ;;
  *)             OC_ASSET=opencode-linux-arm64.tar.gz; OC_LD=ld-linux-aarch64.so.1 ;;
esac
OC_DIR="$PREFIX/libexec/opencode"
OC_BIN="$OC_DIR/opencode"
# V2 flags mirror https://opencode.ai/v2/install (--version/-v, --binary/-b).
OC_ARG_VER=""
OC_BIN_SRC=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) echo "usage: opencode-setup [--version X] [--binary PATH]"; echo "  env: OPENCODE_VERSION=X (or VERSION=X); default: live V2 lookup"; exit 0 ;;
    -v|--version) OC_ARG_VER="${2:-}"; shift 2 ;;
    -b|--binary) OC_BIN_SRC="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
OC_VER="${OC_ARG_VER:-${OPENCODE_VERSION:-${VERSION:-}}}"
OC_VER="${OC_VER#v}"
if [ -z "$OC_VER" ]; then
  echo "opencode-setup: resolving latest V2 version…"
  OC_META=$(curl -fsSL --max-time 20 https://opencode.ai/update/api/latest/cli/npm 2>/dev/null || true)
  OC_VER=$(printf '%s' "$OC_META" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p' | head -1)
  OC_VER="${OC_VER#v}"
  if [ -z "$OC_VER" ]; then
    OC_VER="2.0.6"
    echo "opencode-setup: version lookup failed — using fallback v$OC_VER" >&2
  else
    echo "opencode-setup: latest V2 is v$OC_VER"
  fi
fi
case "$OC_VER" in 1.*|0.*) OC_URL="https://github.com/anomalyco/opencode/releases/download/v$OC_VER/$OC_ASSET" ;;
  *) OC_URL="https://opencode.ai/files/bin/$OC_VER/$OC_ASSET" ;;
esac
if [ -n "$OC_BIN_SRC" ]; then
  echo "opencode-setup: installing from local binary $OC_BIN_SRC…"
  rm -rf "$OC_DIR.new"
  mkdir -p "$OC_DIR.new"
  cp -f "$OC_BIN_SRC" "$OC_DIR.new/opencode"
  chmod +x "$OC_DIR.new/opencode"
  rm -rf "$OC_DIR"
  mv "$OC_DIR.new" "$OC_DIR"
  OC_BIN=$(find "$OC_DIR" -type f -name opencode 2>/dev/null | head -1)
fi
if [ -z "$OC_BIN_SRC" ]; then
echo "Downloading $OC_ASSET (official V2 linux binary; no bun install)…"
echo "  $OC_URL"
mkdir -p "$OC_DIR" "$TMPDIR"
OC_TAR="$TMPDIR/$OC_ASSET"
if command -v curl >/dev/null 2>&1; then
  curl -fL --retry 3 --retry-delay 2 -o "$OC_TAR" "$OC_URL"
elif command -v wget >/dev/null 2>&1; then
  wget -O "$OC_TAR" "$OC_URL"
else
  echo "opencode-setup: need curl or wget" >&2
  exit 127
fi
rm -rf "$OC_DIR.new"
mkdir -p "$OC_DIR.new"
tar -xzf "$OC_TAR" -C "$OC_DIR.new"
rm -f "$OC_TAR"
FOUND=$(find "$OC_DIR.new" -type f -name opencode 2>/dev/null | head -1)
if [ -z "$FOUND" ] || [ ! -f "$FOUND" ]; then
  echo "opencode-setup: tarball had no opencode binary" >&2
  rm -rf "$OC_DIR.new"
  exit 1
fi
chmod +x "$FOUND"
rm -rf "$OC_DIR"
mv "$OC_DIR.new" "$OC_DIR"
OC_BIN=$(find "$OC_DIR" -type f -name opencode 2>/dev/null | head -1)
fi
if [ -z "$OC_BIN" ] || [ ! -x "$OC_BIN" ]; then
  echo "opencode-setup: install failed (binary missing)" >&2
  exit 1
fi
fixup_glibc_paths() {
  local f
  for f in "$PREFIX/opt/glibc-runner/glibc-runner.sh" "$PREFIX/bin/grun"; do
    [ -f "$f" ] || continue
    grep -q "${_stock_pkg}" "$f" 2>/dev/null || continue
    sed -i "s|${_stock_files}|${INVAPP_FILES_DIR}|g" "$f" 2>/dev/null || true
  done
  if [ -f "$PREFIX/glibc/lib/libc.so.6" ]; then
    ln -sfn libc.so.6 "$PREFIX/glibc/lib/libc.so" 2>/dev/null || true
  fi
  if [ -f "$PREFIX/glibc/lib/libm.so.6" ]; then
    ln -sfn libm.so.6 "$PREFIX/glibc/lib/libm.so" 2>/dev/null || true
  fi
  ln -sfn libdl.so.2 "$PREFIX/glibc/lib/libdl.so" 2>/dev/null || true
  ln -sfn libpthread.so.0 "$PREFIX/glibc/lib/libpthread.so" 2>/dev/null || true
  if [ ! -f "$PREFIX/glibc/lib/liblog.so" ] && [ -x "$PREFIX/bin/clang" ]; then
    cat > "$PREFIX/tmp/invapp-liblog-stub.c" <<'STUBEOF'
int __android_log_write(int a, const char* b, const char* c) { (void)a;(void)b;(void)c; return 0; }
int __android_log_print(int a, const char* b, const char* c, ...) { (void)a;(void)b;(void)c; return 0; }
int __android_log_vprint(int a, const char* b, const char* c, void* d) { (void)a;(void)b;(void)c;(void)d; return 0; }
void __android_log_assert(const char* a, const char* b, const char* c, ...) { (void)a;(void)b;(void)c; }
STUBEOF
    "$PREFIX/bin/clang" -shared -nostdlib -fPIC -Wl,-soname,liblog.so \
      -o "$PREFIX/glibc/lib/liblog.so" "$PREFIX/tmp/invapp-liblog-stub.c" 2>/dev/null || true
  fi
  mkdir -p "$PREFIX/etc" "$PREFIX/glibc/etc/ssl/certs"
  if [ ! -s "$PREFIX/etc/resolv.conf" ]; then
    printf '%s\n' 'nameserver 8.8.8.8' 'nameserver 1.1.1.1' > "$PREFIX/etc/resolv.conf"
  fi
  cp -f "$PREFIX/etc/resolv.conf" "$PREFIX/glibc/etc/resolv.conf" 2>/dev/null || \
    printf '%s\n' 'nameserver 8.8.8.8' 'nameserver 1.1.1.1' > "$PREFIX/glibc/etc/resolv.conf"
  if [ ! -s "$PREFIX/etc/hosts" ]; then
    printf '%s\n' '127.0.0.1 localhost' '::1 localhost' > "$PREFIX/etc/hosts"
  fi
  cp -f "$PREFIX/etc/hosts" "$PREFIX/glibc/etc/hosts" 2>/dev/null || true
  if [ -f "$PREFIX/etc/tls/cert.pem" ]; then
    ln -sfn "$PREFIX/etc/tls/cert.pem" \
      "$PREFIX/glibc/etc/ssl/certs/ca-certificates.crt" 2>/dev/null || true
    ln -sfn "$PREFIX/etc/tls/cert.pem" \
      "$PREFIX/glibc/etc/ssl/cert.pem" 2>/dev/null || true
  fi
}
ensure_glibc() {
  if [ -x "$PREFIX/glibc/lib/$OC_LD" ]; then
    fixup_glibc_paths
    return 0
  fi
  echo "opencode-setup: installing glibc (linux binaries need it on Android)…"
  if ! command -v pkg >/dev/null 2>&1 && ! command -v apt-get >/dev/null 2>&1; then
    return 1
  fi
  mkdir -p "$PREFIX/etc/apt/sources.list.d"
  printf '%s\n' \
    'deb [trusted=yes] https://packages-cf.termux.dev/apt/termux-glibc/ glibc stable' \
    > "$PREFIX/etc/apt/sources.list.d/glibc.list"
  export DEBIAN_FRONTEND=noninteractive
  pkg install -y glibc-repo 2>/dev/null || true
  apt-get update -y 2>/dev/null || pkg update -y 2>/dev/null || true
  pkg install -y glibc glibc-runner 2>/dev/null \
    || apt-get install -y glibc glibc-runner 2>/dev/null \
    || pkg install -y glibc 2>/dev/null \
    || apt-get install -y glibc 2>/dev/null \
    || true
  pkg install -y openssl-glibc ca-certificates gcc-glibc 2>/dev/null \
    || apt-get install -y openssl-glibc ca-certificates gcc-glibc 2>/dev/null \
    || true
  if [ ! -x "$PREFIX/glibc/lib/$OC_LD" ]; then
    return 1
  fi
  fixup_glibc_paths
  return 0
}
if ! ensure_glibc; then
  echo "opencode-setup: glibc missing." >&2
  echo "  pkg install glibc-repo && pkg install glibc glibc-runner" >&2
  echo "Then re-run: opencode-setup" >&2
  exit 1
fi
WRAPPER="$PREFIX/bin/opencode"
rm -f "$WRAPPER" "$HOME/.bun/bin/opencode" 2>/dev/null || true
cat > "$WRAPPER" <<EOF
#!$PREFIX/bin/bash
# invapp-opencode-wrapper — OpenCode linux binary via glibc ld-linux
OC_BIN="$OC_BIN"
PREFIX="$PREFIX"
OC_LD="$OC_LD"
LD="\$PREFIX/glibc/lib/\$OC_LD"
LIB="\$PREFIX/glibc/lib"
export TMPDIR="\${TMPDIR:-\$PREFIX/tmp}"
mkdir -p "\$TMPDIR" 2>/dev/null || true
if [ ! -x "\$OC_BIN" ]; then
  echo "opencode: binary missing — run opencode-setup" >&2
  exit 127
fi
if [ ! -x "\$LD" ]; then
  echo "opencode: glibc missing — run opencode-setup" >&2
  exit 127
fi
export LD_PRELOAD=
OC_SHIM="\$PREFIX/lib/libinvapp-opencode-shim.so"
OC_PRELOAD_ARGS=
if [ -f "\$OC_SHIM" ]; then
  OC_PRELOAD_ARGS="--preload \$OC_SHIM"
elif [ -f "\$PREFIX/lib/libinvapp-getifaddrs.so" ]; then
  OC_PRELOAD_ARGS="--preload \$PREFIX/lib/libinvapp-getifaddrs.so"
fi
export LD_LIBRARY_PATH=
mkdir -p "\$PREFIX/glibc/etc/ssl/certs" 2>/dev/null || true
if [ ! -s "\$PREFIX/etc/resolv.conf" ]; then
  printf '%s\n' 'nameserver 8.8.8.8' 'nameserver 1.1.1.1' > "\$PREFIX/etc/resolv.conf"
fi
cp -f "\$PREFIX/etc/resolv.conf" "\$PREFIX/glibc/etc/resolv.conf" 2>/dev/null || true
if [ -f "\$PREFIX/etc/tls/cert.pem" ]; then
  export SSL_CERT_FILE="\$PREFIX/etc/tls/cert.pem"
  export CURL_CA_BUNDLE="\$PREFIX/etc/tls/cert.pem"
  export NODE_EXTRA_CA_CERTS="\$PREFIX/etc/tls/cert.pem"
  mkdir -p "\$PREFIX/etc/tls/certs" "\$PREFIX/glibc/etc/ssl/certs" 2>/dev/null || true
  ln -sfn "\$PREFIX/etc/tls/cert.pem" \
    "\$PREFIX/etc/tls/certs/ca-certificates.crt" 2>/dev/null || true
  ln -sfn "\$PREFIX/etc/tls/cert.pem" \
    "\$PREFIX/glibc/etc/ssl/certs/ca-certificates.crt" 2>/dev/null || true
  export SSL_CERT_DIR="\$PREFIX/etc/tls/certs"
fi
export PATH="\$PREFIX/bin:\$PATH"
# V2 CLI defaults to \`opencode service start\` (service.ensure). Under
# glibc/ld-linux that looks for a native \`serve\` helper and dies with:
#   serve: error while loading shared libraries: serve: …
# Prefer an already-running foreground server (td-ai / opencode-server on
# :4000), else --standalone (private server, no shared service).
_oc_pw_file="\$PREFIX/var/lib/invapp/opencode-password"
_oc_port="\${OPENCODE_PORT:-4000}"
_oc_url="http://127.0.0.1:\$_oc_port"
_oc_pw="\${OPENCODE_PASSWORD:-\${OPENCODE_SERVER_PASSWORD:-}}"
if [ -z "\$_oc_pw" ] && [ -s "\$_oc_pw_file" ]; then
  _oc_pw=\$(tr -d '[:space:]' < "\$_oc_pw_file")
fi
_oc_pass_through=0
case "\${1:-}" in
  serve|service|auth|upgrade|uninstall|mcp|github|pr|agent|import|export|models|stats|web)
    _oc_pass_through=1 ;;
esac
for _a in "\$@"; do
  case "\$_a" in
    --server|--standalone|--help|-h|help) _oc_pass_through=1; break ;;
  esac
done
if [ "\$_oc_pass_through" = 0 ]; then
  _oc_curl_auth=""
  if [ -n "\$_oc_pw" ]; then
    _oc_curl_auth="-u opencode:\$_oc_pw"
  fi
  # shellcheck disable=SC2086
  if curl -fsS \$_oc_curl_auth --connect-timeout 1 --max-time 2 \
      "\$_oc_url/api/info" 2>/dev/null | grep -qi '"data"\|version'; then
    [ -n "\$_oc_pw" ] && export OPENCODE_PASSWORD="\$_oc_pw" OPENCODE_SERVER_PASSWORD="\$_oc_pw"
    set -- --server "\$_oc_url" "\$@"
  else
    echo "opencode: no healthy server on :\$_oc_port — using --standalone" >&2
    echo "  (shared service is broken under glibc; prefer: td-ai then opencode)" >&2
    set -- --standalone "\$@"
  fi
fi
# shellcheck disable=SC2086
exec "\$LD" --library-path "\$LIB" \$OC_PRELOAD_ARGS "\$OC_BIN" "\$@"
EOF
chmod 700 "$WRAPPER"
mkdir -p "$HOME/.bun/bin" "$PREFIX/lib"
build_opencode_shim() {
  local stub_c="$PREFIX/tmp/invapp-opencode-shim.c"
  local stub_so="$PREFIX/lib/libinvapp-opencode-shim.so"
  local stub_map="$PREFIX/tmp/invapp-opencode-shim.map"
  local cc=""
  if [ -f "$stub_so" ] && [ -s "$stub_so" ]; then
    echo "opencode-setup: using existing DNS shim → $stub_so"
    return 0
  fi
  for cc in "$PREFIX/glibc/bin/gcc" "$PREFIX/bin/aarch64-linux-gnu-gcc" \
            "$PREFIX/bin/x86_64-linux-gnu-gcc" "$PREFIX/bin/gcc-glibc"; do
    [ -x "$cc" ] || continue
    break
  done
  if [ -z "$cc" ] || [ ! -x "$cc" ]; then
    echo "opencode-setup: no gcc-glibc — keep shipped shim or: pkg install gcc-glibc" >&2
    return 0
  fi
  cat > "$stub_c" <<STUBC
#define _GNU_SOURCE
#include <arpa/inet.h>
#include <dlfcn.h>
#include <errno.h>
#include <fcntl.h>
#include <ifaddrs.h>
#include <net/if.h>
#include <netdb.h>
#include <netinet/in.h>
#include <stdarg.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <time.h>
#include <unistd.h>
static const char *INVAPP_RESOLV ="$PREFIX/etc/resolv.conf";
static const char *INVAPP_HOSTS ="$PREFIX/etc/hosts";
static const char *INVAPP_CERT ="$PREFIX/etc/tls/cert.pem";
static const char *INVAPP_PREFIX ="$PREFIX";
static const char *STOCK_PREFIX ="$(printf '%s' 'L2RhdGEvZGF0YS9jb20udGVybXV4L2ZpbGVzL3Vzc' | base64 -d)";
static char g_redir_buf[512];
static const char *redirect_path(const char *path) {
  size_t stock_len;
  if (!path) return path;
  if (strcmp(path, "/etc/resolv.conf") == 0) return INVAPP_RESOLV;
  if (strcmp(path, "/etc/hosts") == 0) return INVAPP_HOSTS;
  if (strcmp(path, "/etc/ssl/cert.pem") == 0) return INVAPP_CERT;
  if (strcmp(path, "/etc/ssl/certs/ca-certificates.crt") == 0) return INVAPP_CERT;
  if (strcmp(path, "/etc/pki/tls/certs/ca-bundle.crt") == 0) return INVAPP_CERT;
  stock_len = strlen(STOCK_PREFIX);
  if (strncmp(path, STOCK_PREFIX, stock_len) == 0) {
    size_t rest = strlen(path + stock_len);
    if (strlen(INVAPP_PREFIX) + rest + 1 > sizeof(g_redir_buf)) return path;
    memcpy(g_redir_buf, INVAPP_PREFIX, strlen(INVAPP_PREFIX) + 1);
    memcpy(g_redir_buf + strlen(INVAPP_PREFIX), path + stock_len, rest + 1);
    return g_redir_buf;
  }
  return path;
}
int open(const char *path, int flags, ...) {
  static int (*real_open)(const char *, int, ...) = 0;
  if (!real_open) real_open = (int (*)(const char *, int, ...))dlsym(RTLD_NEXT, "open");
  path = redirect_path(path);
  if (flags & O_CREAT) { va_list ap; va_start(ap, flags); mode_t m=(mode_t)va_arg(ap,int); va_end(ap); return real_open(path, flags, m); }
  return real_open(path, flags);
}
int openat(int dirfd, const char *path, int flags, ...) {
  static int (*real_openat)(int, const char *, int, ...) = 0;
  if (!real_openat) real_openat = (int (*)(int, const char *, int, ...))dlsym(RTLD_NEXT, "openat");
  path = redirect_path(path);
  if (flags & O_CREAT) { va_list ap; va_start(ap, flags); mode_t m=(mode_t)va_arg(ap,int); va_end(ap); return real_openat(dirfd, path, flags, m); }
  return real_openat(dirfd, path, flags);
}
typedef int (*ga_fn)(const char*,const char*,const struct addrinfo*,struct addrinfo**);
static ga_fn real_ga(void) { static ga_fn c; if (!c) c=(ga_fn)dlsym(RTLD_NEXT,"getaddrinfo"); return c; }
static int encode_qname(const char *host, unsigned char *out, size_t outlen) {
  size_t used=0; const char *p=host;
  while (*p) { const char *dot=strchr(p,'.'); size_t len=dot?(size_t)(dot-p):strlen(p);
    if (len==0||len>63||used+len+2>outlen) return -1;
    out[used++]=(unsigned char)len; memcpy(out+used,p,len); used+=len;
    if (!dot) break; p=dot+1; if (!*p) break; }
  if (used+1>outlen) return -1; out[used++]=0; return (int)used;
}
static int skip_name(const unsigned char *pkt, int len, int off) {
  while (off < len) { unsigned char l=pkt[off]; if (l==0) return off+1;
    if ((l&0xC0)==0xC0) return off+2<=len?off+2:-1; off+=l+1; } return -1;
}
static int query_a(const char *server, const char *host, struct in_addr *addrs, int max_addrs) {
  unsigned char pkt[1500]; struct sockaddr_in sa; struct timeval tv; struct timespec ts;
  int fd,qlen,off,qdcount,ancount,found=0; uint16_t id; ssize_t n;
  memset(&sa,0,sizeof(sa)); sa.sin_family=AF_INET; sa.sin_port=htons(53);
  if (inet_pton(AF_INET,server,&sa.sin_addr)!=1) return -1;
  clock_gettime(CLOCK_MONOTONIC,&ts); id=(uint16_t)((ts.tv_nsec^(getpid()<<8))&0xFFFF);
  memset(pkt,0,12); pkt[0]=id>>8; pkt[1]=id&0xFF; pkt[2]=0x01; pkt[5]=0x01;
  qlen=encode_qname(host,pkt+12,sizeof(pkt)-16); if (qlen<0) return -1;
  off=12+qlen; pkt[off++]=0; pkt[off++]=1; pkt[off++]=0; pkt[off++]=1;
  fd=socket(AF_INET,SOCK_DGRAM,0); if (fd<0) return -1;
  tv.tv_sec=3; tv.tv_usec=0; setsockopt(fd,SOL_SOCKET,SO_RCVTIMEO,&tv,sizeof(tv));
  if (sendto(fd,pkt,off,0,(struct sockaddr*)&sa,sizeof(sa))!=off) { close(fd); return -1; }
  n=recvfrom(fd,pkt,sizeof(pkt),0,NULL,NULL); close(fd);
  if (n<12||pkt[0]!=(id>>8)||pkt[1]!=(id&0xFF)||(pkt[3]&0x0F)) return -1;
  qdcount=(pkt[4]<<8)|pkt[5]; ancount=(pkt[6]<<8)|pkt[7]; off=12;
  for (int i=0;i<qdcount;i++) { off=skip_name(pkt,(int)n,off); if (off<0||off+4>n) return -1; off+=4; }
  for (int i=0;i<ancount&&found<max_addrs;i++) {
    int type,rdlen; off=skip_name(pkt,(int)n,off); if (off<0||off+10>n) break;
    type=(pkt[off]<<8)|pkt[off+1]; rdlen=(pkt[off+8]<<8)|pkt[off+9]; off+=10;
    if (off+rdlen>n) break; if (type==1&&rdlen==4) memcpy(&addrs[found++],pkt+off,4); off+=rdlen;
  } return found;
}
static uint16_t resolve_port(const char *service) {
  if (!service||!*service) return 0; char *end; long v=strtol(service,&end,10);
  if (*end=='\0'&&v>=0&&v<=65535) return (uint16_t)v;
  if (!strcmp(service,"https")) return 443; if (!strcmp(service,"http")) return 80; return 0;
}
static int build_result(const struct in_addr *addrs, int count, uint16_t port,
  const struct addrinfo *hints, struct addrinfo **res) {
  struct addrinfo *head=NULL,*tail=NULL;
  int socktype=hints&&hints->ai_socktype?hints->ai_socktype:SOCK_STREAM;
  int protocol=hints&&hints->ai_protocol?hints->ai_protocol:(socktype==SOCK_DGRAM?IPPROTO_UDP:IPPROTO_TCP);
  for (int i=0;i<count;i++) {
    struct addrinfo *ai=calloc(1,sizeof(*ai)); struct sockaddr_in *sin=calloc(1,sizeof(*sin));
    if (!ai||!sin) { free(ai); free(sin); freeaddrinfo(head); return EAI_MEMORY; }
    sin->sin_family=AF_INET; sin->sin_port=htons(port); sin->sin_addr=addrs[i];
    ai->ai_family=AF_INET; ai->ai_socktype=socktype; ai->ai_protocol=protocol;
    ai->ai_addrlen=sizeof(*sin); ai->ai_addr=(struct sockaddr*)sin;
    if (tail) tail->ai_next=ai; else head=ai; tail=ai;
  } if (!head) return EAI_NONAME; *res=head; return 0;
}
int getaddrinfo(const char *node, const char *service,
  const struct addrinfo *hints, struct addrinfo **res) {
  ga_fn orig=real_ga(); struct in_addr addrs[8]; int rc;
  static const char *ns[] = {"8.8.8.8","1.1.1.1","8.8.4.4"};
  if (!node||!*node) { if (!orig) return EAI_SYSTEM; return orig(node,service,hints,res); }
  if (hints) { if (hints->ai_flags&AI_NUMERICHOST) { if (!orig) return EAI_SYSTEM; return orig(node,service,hints,res); }
    if (hints->ai_family!=AF_UNSPEC&&hints->ai_family!=AF_INET) { if (!orig) return EAI_SYSTEM; return orig(node,service,hints,res); } }
  for (int i=0;i<3;i++) {
    int found=query_a(ns[i],node,addrs,8);
    if (found>0) { int brc=build_result(addrs,found,resolve_port(service),hints,res);
      return brc!=0?brc:0; }
  } if (!orig) return EAI_SYSTEM; return orig(node,service,hints,res);
}
static struct hostent g_he; static char g_he_name[256]; static char *g_he_aliases[1];
static struct in_addr g_he_addrs[8]; static char *g_he_addr_list[9];
struct hostent *gethostbyname2(const char *name, int af) {
  static struct hostent *(*real_ghn2)(const char*,int)=0; struct in_addr addrs[8]; int found=0;
  static const char *ns[] = {"8.8.8.8","1.1.1.1","8.8.4.4"};
  if (!real_ghn2) real_ghn2=(struct hostent*(*)(const char*,int))dlsym(RTLD_NEXT,"gethostbyname2");
  if (af!=AF_INET&&af!=AF_UNSPEC) return real_ghn2?real_ghn2(name,af):NULL;
  if (!name||!*name) return real_ghn2?real_ghn2(name,af):NULL;
  for (int i=0;i<3&&found<=0;i++) found=query_a(ns[i],name,addrs,8);
  if (found<=0) return real_ghn2?real_ghn2(name,af):NULL;
  memset(&g_he,0,sizeof(g_he)); strncpy(g_he_name,name,sizeof(g_he_name)-1);
  g_he_aliases[0]=NULL; for (int i=0;i<found;i++) { g_he_addrs[i]=addrs[i]; g_he_addr_list[i]=(char*)&g_he_addrs[i]; }
  g_he_addr_list[found]=NULL; g_he.h_name=g_he_name; g_he.h_aliases=g_he_aliases;
  g_he.h_addrtype=AF_INET; g_he.h_length=4; g_he.h_addr_list=g_he_addr_list; return &g_he;
}
struct hostent *gethostbyname(const char *name) { return gethostbyname2(name,AF_INET); }
int getifaddrs(struct ifaddrs **ifap) {
  struct ifaddrs *ifa; struct sockaddr_in *addr,*mask;
  if (!ifap) { errno=EINVAL; return -1; }
  ifa=(struct ifaddrs*)calloc(1,sizeof(*ifa));
  addr=(struct sockaddr_in*)calloc(1,sizeof(*addr));
  mask=(struct sockaddr_in*)calloc(1,sizeof(*mask));
  if (!ifa||!addr||!mask) { free(ifa); free(addr); free(mask); errno=ENOMEM; return -1; }
  ifa->ifa_name=strdup("lo"); ifa->ifa_flags=IFF_UP|IFF_LOOPBACK|IFF_RUNNING;
  addr->sin_family=AF_INET; addr->sin_addr.s_addr=htonl(INADDR_LOOPBACK);
  mask->sin_family=AF_INET; mask->sin_addr.s_addr=htonl(0xFF000000u);
  ifa->ifa_addr=(struct sockaddr*)addr; ifa->ifa_netmask=(struct sockaddr*)mask;
  *ifap=ifa; return 0;
}
void freeifaddrs(struct ifaddrs *ifa) {
  while (ifa) { struct ifaddrs *n=ifa->ifa_next;
    free(ifa->ifa_name); free(ifa->ifa_addr); free(ifa->ifa_netmask); free(ifa); ifa=n; }
}
