#!@BASH@
# ivx-disk-analyze — Termux-oriented disk report (toybox df + du).
#
# Uses Android/toybox `df` (and `du` when available) to show where space goes
# under $PREFIX, $HOME, shared storage, and optional proot/udocker guests.
# Pure bash — same style as ivx-cleanup / ivx-configure.
#
#   ivx-disk-analyze              overview (default)
#   ivx-disk-analyze df           raw df -h for Termux-relevant mounts
#   ivx-disk-analyze prefix       top dirs under $PREFIX
#   ivx-disk-analyze home         top dirs under $HOME
#   ivx-disk-analyze guests       proot-distro / td-udocker / debian-container
#   ivx-disk-analyze large [DIR]  largest files under DIR (default: $HOME)
#   ivx-disk-analyze help

set -u

IVX_DISK_VERSION=1.0.0

if [ -z "${PREFIX:-}" ]; then
    PREFIX=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P) || PREFIX=''
fi
: "${PREFIX:?PREFIX is not set — run ivx-disk-analyze inside Termux}"
HOME="${HOME:-$PREFIX/../home}"
# Resolve HOME when it is still relative to PREFIX layout.
if [ ! -d "$HOME" ] && [ -d "$PREFIX/../home" ]; then
    HOME=$(cd "$PREFIX/../home" 2>/dev/null && pwd -P) || HOME="$PREFIX/../home"
fi

OPT_NO_COLOR=0
OPT_TOP=12
_ivx_args=()
for _a in "$@"; do
    case "$_a" in
        --no-color) OPT_NO_COLOR=1 ;;
        --top=*) OPT_TOP="${_a#--top=}" ;;
        -h|--help|help) _ivx_args+=("help") ;;
        *) _ivx_args+=("$_a") ;;
    esac
done
set -- ${_ivx_args[@]+"${_ivx_args[@]}"}

case "$OPT_TOP" in
    ''|*[!0-9]*) OPT_TOP=12 ;;
esac

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$OPT_NO_COLOR" = 0 ]; then
    C_RST=$'\033[0m' C_B=$'\033[1m' C_DIM=$'\033[2m'
    C_G=$'\033[1;32m' C_C=$'\033[1;36m' C_Y=$'\033[1;33m' C_R=$'\033[1;31m'
else
    C_RST='' C_B='' C_DIM='' C_G='' C_C='' C_Y='' C_R=''
fi

info()  { printf '%s%s%s\n' "$C_C" "$*" "$C_RST"; }
ok()    { printf '%s%s%s\n' "$C_G" "$*" "$C_RST"; }
warn()  { printf '%s%s%s\n' "$C_Y" "$*" "$C_RST" >&2; }
err()   { printf '%s%s%s\n' "$C_R" "$*" "$C_RST" >&2; }
hr()    { printf '%s────────────────────────────────────────%s\n' "$C_DIM" "$C_RST"; }

# Human size from 1K-blocks (du -sk) or bytes.
human_k() {
    # awk: input is KiB
    awk -v k="$1" 'BEGIN {
        if (k+0 < 0) k = 0
        u[0]="K"; u[1]="M"; u[2]="G"; u[3]="T"
        x = k + 0; i = 0
        while (x >= 1024 && i < 3) { x /= 1024; i++ }
        if (i == 0) printf "%d%s", x, u[i]
        else printf "%.1f%s", x, u[i]
    }'
}

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------------------
# df helpers (toybox)
# ---------------------------------------------------------------------------
cmd_df() {
    printf '\n  %sMounted filesystems (df -h)%s\n' "$C_B" "$C_RST"
    hr
    if ! have df; then
        err "df not found"
        return 1
    fi
    # Prefer paths that matter for InVxTermux; fall back to all mounts.
    _paths=()
    for _p in "$PREFIX" "$HOME" /data /storage/emulated/0 /sdcard; do
        [ -e "$_p" ] || continue
        _paths+=("$_p")
    done
    if [ "${#_paths[@]}" -gt 0 ]; then
        df -h "${_paths[@]}" 2>/dev/null || df -h
    else
        df -h
    fi
    printf '\n'
    info "Tip: df -ahi  (inodes) · df -a  (all mounts incl. /proc)"
}

# One-line summary for a path: Size Used Avail Use% from df -k.
df_line_for() {
    _path="$1"
    _label="$2"
    [ -e "$_path" ] || { printf '  %-18s  %s\n' "$_label" "(missing)"; return 0; }
    # toybox df -k: Filesystem 1K-blocks Used Available Use% Mounted on
    _out=$(df -k "$_path" 2>/dev/null | awk 'NR==2 {print}')
    if [ -z "$_out" ]; then
        printf '  %-18s  %s\n' "$_label" "(df failed)"
        return 0
    fi
    # shellcheck disable=SC2086
    set -- $_out
    # $2=1K-blocks $3=Used $4=Available $5=Use% $6+=mount
    _total_k=${2:-0}
    _used_k=${3:-0}
    _avail_k=${4:-0}
    _pct=${5:-?}
    _mnt=${6:-}
    printf '  %-18s  %s used / %s free  (%s of %s)%s\n' \
        "$_label" \
        "$(human_k "$_used_k")" \
        "$(human_k "$_avail_k")" \
        "$_pct" \
        "$(human_k "$_total_k")" \
        "${_mnt:+  [$_mnt]}"
}

# ---------------------------------------------------------------------------
# du helpers
# ---------------------------------------------------------------------------
du_top() {
    _root="$1"
    _title="$2"
    printf '\n  %s%s%s\n' "$C_B" "$_title" "$C_RST"
    hr
    if [ ! -d "$_root" ]; then
        warn "missing: $_root"
        return 0
    fi
    if ! have du; then
        err "du not found"
        return 1
    fi
    # Depth-1 sizes; sort numeric; head. Skip permission errors.
    # BusyBox/toybox du -sk works on Android.
    _tmp=$(mktemp 2>/dev/null || echo "$PREFIX/tmp/ivx-disk.$$")
    mkdir -p "$(dirname "$_tmp")" 2>/dev/null || true
    (
        cd "$_root" || exit 0
        for _d in * .[!.]*; do
            [ -e "$_d" ] || continue
            du -sk "$_d" 2>/dev/null
        done
    ) >"$_tmp" 2>/dev/null || true

    if [ ! -s "$_tmp" ]; then
        warn "nothing measurable under $_root"
        rm -f "$_tmp"
        return 0
    fi

    sort -nr "$_tmp" | head -n "$OPT_TOP" | while IFS= read -r _line; do
        # shellcheck disable=SC2086
        set -- $_line
        _k=$1
        shift
        _name=$*
        printf '  %8s  %s\n' "$(human_k "$_k")" "$_name"
    done
    _sum=$(awk '{s+=$1} END{print s+0}' "$_tmp")
    printf '  %s%8s  (sum of depth-1)%s\n' "$C_DIM" "$(human_k "$_sum")" "$C_RST"
    rm -f "$_tmp"
}

cmd_prefix() { du_top "$PREFIX" "\$PREFIX top dirs  ($PREFIX)"; }
cmd_home()   { du_top "$HOME" "\$HOME top dirs  ($HOME)"; }

cmd_guests() {
    printf '\n  %sGuest / container trees%s\n' "$C_B" "$C_RST"
    hr
    _found=0
    for _g in \
        "$HOME/debian-container" \
        "$PREFIX/var/lib/proot-distro" \
        "$PREFIX/var/td-udocker" \
        "$PREFIX/var/lib/udocker"
    do
        if [ -d "$_g" ]; then
            _found=1
            _k=$(du -sk "$_g" 2>/dev/null | awk '{print $1}')
            printf '  %8s  %s\n' "$(human_k "${_k:-0}")" "$_g"
            # One level deeper for the interesting ones.
            if [ -d "$_g/rootfs" ] || [ -d "$_g/installed-rootfs" ] || [ -d "$_g/rootfs" ]; then
                du_top "$_g" "  inside $(basename "$_g")"
            elif [ -d "$_g" ]; then
                # show children briefly
                (
                    cd "$_g" 2>/dev/null || exit 0
                    for _c in *; do
                        [ -e "$_c" ] || continue
                        _ck=$(du -sk "$_c" 2>/dev/null | awk '{print $1}')
                        [ -n "$_ck" ] || continue
                        printf '           %8s  %s\n' "$(human_k "$_ck")" "$_c"
                    done
                ) 2>/dev/null | sort -k1 -h -r 2>/dev/null | head -n "$OPT_TOP" || true
            fi
        fi
    done
    if [ "$_found" = 0 ]; then
        info "No guest trees found (debian-container / proot-distro / td-udocker)."
    fi
}

cmd_large() {
    _root="${1:-$HOME}"
    printf '\n  %sLargest files under %s%s\n' "$C_B" "$_root" "$C_RST"
    hr
    if [ ! -d "$_root" ]; then
        err "not a directory: $_root"
        return 1
    fi
    if ! have find || ! have du; then
        # find is usually toybox; fall back to du -a
        warn "using du -a (find missing or limited)"
        du -ak "$_root" 2>/dev/null | sort -nr | head -n "$OPT_TOP" | while IFS= read -r _line; do
            # shellcheck disable=SC2086
            set -- $_line
            _k=$1; shift
            printf '  %8s  %s\n' "$(human_k "$_k")" "$*"
        done
        return 0
    fi
    # Files only, skip /proc-like noise.
    find "$_root" -type f \( -path '*/.git/objects/*' -o -path '*/proc/*' \) -prune -o \
        -type f -print0 2>/dev/null \
        | xargs -0 du -sk 2>/dev/null \
        | sort -nr \
        | head -n "$OPT_TOP" \
        | while IFS= read -r _line; do
            # shellcheck disable=SC2086
            set -- $_line
            _k=$1; shift
            printf '  %8s  %s\n' "$(human_k "$_k")" "$*"
        done
}

cmd_overview() {
    printf '\n  %sivx-disk-analyze%s  v%s\n' "$C_B" "$C_RST" "$IVX_DISK_VERSION"
    hr
    printf '  PREFIX  %s\n' "$PREFIX"
    printf '  HOME    %s\n' "$HOME"
    printf '\n  %sFilesystem free space%s\n' "$C_B" "$C_RST"
    hr
    df_line_for "$PREFIX" "Termux prefix"
    df_line_for "$HOME" "Termux home"
    df_line_for /storage/emulated/0 "Shared storage"
    df_line_for /data "Android /data"

    cmd_prefix
    cmd_home

    printf '\n  %sCaches / installers (quick)%s\n' "$C_B" "$C_RST"
    hr
    for _c in \
        "$HOME/.bun" \
        "$HOME/.npm" \
        "$HOME/.cache" \
        "$HOME/.cargo" \
        "$HOME/.local/share" \
        "$PREFIX/var/cache" \
        "$PREFIX/tmp" \
        "$HOME/repos"
    do
        if [ -e "$_c" ]; then
            _k=$(du -sk "$_c" 2>/dev/null | awk '{print $1}')
            printf '  %8s  %s\n' "$(human_k "${_k:-0}")" "$_c"
        fi
    done

    cmd_guests

    printf '\n'
    info "More: ivx-disk-analyze df | prefix | home | guests | large [DIR]"
    info "Cleanup globals: ivx-cleanup"
}

cmd_help() {
    cat <<EOF
ivx-disk-analyze — disk report for InVxTermux (toybox df + du)

Usage:
  ivx-disk-analyze                 overview (df summary + top dirs + caches)
  ivx-disk-analyze df              df -h for Termux-relevant paths
  ivx-disk-analyze prefix          top entries under \$PREFIX
  ivx-disk-analyze home            top entries under \$HOME
  ivx-disk-analyze guests          debian-container / proot-distro / td-udocker
  ivx-disk-analyze large [DIR]     largest files (default: \$HOME)
  ivx-disk-analyze help

Flags:
  --top=N       how many rows to show (default: 12)
  --no-color    disable ANSI colours

Notes:
  Shared storage (/storage/emulated/0) is often noexec — keep build trees in
  ~/repos. Guest rootfs trees under \$PREFIX/var can be multi‑GB; remove with
  pd remove / td-udocker cleanup when unused.
EOF
}

_cmd=${1:-overview}
[ $# -gt 0 ] && shift

case "$_cmd" in
    overview|menu|"") cmd_overview ;;
    df) cmd_df ;;
    prefix|usr) cmd_prefix ;;
    home) cmd_home ;;
    guests|guest|containers) cmd_guests ;;
    large|biggest) cmd_large "${1:-$HOME}" ;;
    help|-h|--help) cmd_help ;;
    *)
        err "unknown command: $_cmd"
        cmd_help
        exit 2
        ;;
esac
