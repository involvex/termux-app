#!/system/bin/sh
# INVAPP_PROOT_WRAPPER=1
# Fork-safe proot for InVxTermux / Terminal Dev.
#
# Must use /system/bin/sh — NOT Termux bash. Callers (pd, run.sh) often exec
# this wrapper under a cleaned env; Termux bash then dies with
# libandroid-support.so not found.
#
# Host proot-bin needs libtalloc.so.2, but DT_RUNPATH still points at the stock
# com.termux prefix on this fork (and LD_PRELOAD is cleared so the path
# redirector cannot rewrite linker opens). Putting ONLY libtalloc into
# $PREFIX/libexec/proot-libs and setting LD_LIBRARY_PATH to that dir lets the
# host ELF load without leaking Termux's full $PREFIX/lib into the guest
# (full $PREFIX/lib → guest "libc.so: cannot open shared object file").
#
# Stock proot under LD_PRELOAD=libinvapp-redirector.so also breaks guest
# execve("/usr/bin/bash"). This wrapper:
#   * runs the real ELF at $PREFIX/libexec/proot-bin
#   * sets PROOT_LOADER / PROOT_TMP_DIR / PROOT_NO_SECCOMP
#   * LD_PRELOAD= (empty — not unset — so redirector does not reinject)
#   * LD_LIBRARY_PATH=$PREFIX/libexec/proot-libs (libtalloc only)
#
# Termux proot does NOT support upstream -e/--env.
#
# Reseeded on every app start. After `pkg reinstall proot`, reopen the app or
# run a helper that calls td_udocker_ensure_proot (moves ELF back to libexec).

REAL="${INVAPP_PROOT_BIN:-$PREFIX/libexec/proot-bin}"
if [ ! -x "$REAL" ]; then
    for _c in "$PREFIX/libexec/proot/proot" "$PREFIX/lib/proot/proot"; do
        if [ -x "$_c" ]; then
            REAL="$_c"
            break
        fi
    done
fi
if [ ! -x "$REAL" ]; then
    echo "proot: missing ELF at \$PREFIX/libexec/proot-bin" >&2
    echo "  install: pkg install -y proot && reopen the app (reseeds wrapper)" >&2
    exit 127
fi

PROOT_LIBS="${INVAPP_PROOT_LIBDIR:-$PREFIX/libexec/proot-libs}"
if [ ! -e "$PROOT_LIBS/libtalloc.so.2" ] && [ -d "$PREFIX/lib" ]; then
    mkdir -p "$PROOT_LIBS" 2>/dev/null || true
    for _t in "$PREFIX/lib"/libtalloc.so*; do
        [ -e "$_t" ] || continue
        ln -sf "$_t" "$PROOT_LIBS/" 2>/dev/null \
            || cp -f "$_t" "$PROOT_LIBS/" 2>/dev/null || true
    done
fi

export PROOT_NO_SECCOMP="${PROOT_NO_SECCOMP:-1}"
export PROOT_TMP_DIR="${PROOT_TMP_DIR:-$PREFIX/tmp/proot}"
mkdir -p "$PROOT_TMP_DIR" "${PREFIX:-/tmp}/tmp" 2>/dev/null || true

if [ -z "${PROOT_LOADER:-}" ]; then
    for _l in "$PREFIX/libexec/proot/loader" "$PREFIX/lib/proot/loader"; do
        if [ -x "$_l" ]; then
            export PROOT_LOADER="$_l"
            break
        fi
    done
fi

# Narrow LD_LIBRARY_PATH: libtalloc for host ELF only — never full $PREFIX/lib.
# Do not pass -e (unknown on Termux proot).
exec env LD_PRELOAD= LD_LIBRARY_PATH="$PROOT_LIBS" "$REAL" "$@"
