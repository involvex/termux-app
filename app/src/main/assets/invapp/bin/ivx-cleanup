#!@BASH@
# ivx-cleanup — interactive cleanup for global package installs.
#
# Managers: Termux pkg (apt), cargo, bun -g, npm -g, pip/pip3, uv tool.
# Pure bash (same style as ivx-configure). Never touches project-local
# node_modules / target / .venv unless you pick a listed global tool.
#
#   ivx-cleanup              interactive menu
#   ivx-cleanup pkg          jump to Termux packages
#   ivx-cleanup cargo|bun|npm|pip|uv
#   ivx-cleanup --dry-run …

set -u

IVX_CLEANUP_VERSION=1.0.0

if [ -z "${PREFIX:-}" ]; then
    PREFIX=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P) || PREFIX=''
fi
: "${PREFIX:?PREFIX is not set — run ivx-cleanup inside Termux}"
export PATH="$PREFIX/bin:${HOME:-}/.bun/bin:${HOME:-}/.cargo/bin:${HOME:-}/.local/bin:$PATH"

OPT_YES=0
OPT_DRY=0
OPT_NO_COLOR=0
_ivx_args=()
for _a in "$@"; do
    case "$_a" in
        -y|--yes) OPT_YES=1 ;;
        --dry-run) OPT_DRY=1 ;;
        --no-color) OPT_NO_COLOR=1 ;;
        -h|--help|help) _ivx_args+=("help") ;;
        *) _ivx_args+=("$_a") ;;
    esac
done
set -- ${_ivx_args[@]+"${_ivx_args[@]}"}

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$OPT_NO_COLOR" = 0 ]; then
    C_RST=$'\033[0m' C_B=$'\033[1m' C_DIM=$'\033[2m'
    C_G=$'\033[1;32m' C_C=$'\033[1;36m' C_Y=$'\033[1;33m' C_R=$'\033[1;31m'
else
    C_RST='' C_B='' C_DIM='' C_G='' C_C='' C_Y='' C_R=''
fi

info()  { printf '%s%s%s\n' "$C_C" "$*" "$C_RST"; }
ok()    { printf '%s%s%s\n' "$C_G" "$*" "$C_RST"; }
warn()  { printf '%s%s%s\n' "$C_Y" "$*" "$C_RST" >&2; }
err()   { printf '%s%s%s\n' "$C_R" "$*" "$C_RST" >&2; }
hr()    { printf '%s────────────────────────────────────────%s\n' "$C_DIM" "$C_RST"; }

ask() {
    printf '%s' "$1"
    IFS= read -r IVX_REPLY || return 1
}

pause() {
    [ -t 0 ] || return 0
    printf '%sPress Enter…%s' "$C_DIM" "$C_RST"
    IFS= read -r _ || true
    printf '\n'
}

run_cmd() {
    if [ "$OPT_DRY" = 1 ]; then
        info "dry-run: $*"
        return 0
    fi
    "$@"
}

# ---------------------------------------------------------------------------
# list helpers → newline-separated names on stdout
# ---------------------------------------------------------------------------
list_pkg() {
    if command -v apt-mark >/dev/null 2>&1; then
        apt-mark showmanual 2>/dev/null | sort -u
        return 0
    fi
    if command -v dpkg-query >/dev/null 2>&1; then
        dpkg-query -W -f='${Package}\n' 2>/dev/null | sort -u
        return 0
    fi
    return 1
}

list_cargo() {
    command -v cargo >/dev/null 2>&1 || return 1
    cargo install --list 2>/dev/null | awk '/^[^ ]/ { gsub(/:$/, "", $1); print $1 }' | sort -u
}

list_bun() {
    command -v bun >/dev/null 2>&1 || return 1
    # bun pm ls -g prints a tree; prefer parseable global dir.
    _g="${HOME:-}/.bun/install/global/node_modules"
    if [ -d "$_g" ]; then
        for _d in "$_g"/*; do
            [ -e "$_d" ] || continue
            _n=$(basename "$_d")
            case "$_n" in
                .*|@*) continue ;;
            esac
            printf '%s\n' "$_n"
        done
        # scoped packages
        for _s in "$_g"/@*; do
            [ -d "$_s" ] || continue
            _scope=$(basename "$_s")
            for _d in "$_s"/*; do
                [ -e "$_d" ] || continue
                printf '%s/%s\n' "$_scope" "$(basename "$_d")"
            done
        done
        return 0
    fi
    bun pm ls -g 2>/dev/null | awk '/^[[:space:]]+[a-zA-Z@]/ { print $1 }' | sort -u
}

list_npm() {
    command -v npm >/dev/null 2>&1 || return 1
    npm list -g --depth=0 --parseable 2>/dev/null | while IFS= read -r _p; do
        [ -n "$_p" ] || continue
        case "$_p" in
            */node_modules) continue ;;
            */node_modules/*)
                _n=${_p##*/node_modules/}
                [ "$_n" = "npm" ] && continue
                printf '%s\n' "$_n"
                ;;
        esac
    done | sort -u
}

list_pip() {
    _pip=""
    for _c in pip3 pip; do
        if command -v "$_c" >/dev/null 2>&1; then
            _pip=$_c
            break
        fi
    done
    [ -n "$_pip" ] || return 1
    # Prefer user site; fall back to all.
    if "$_pip" list --user --format=freeze >/dev/null 2>&1; then
        "$_pip" list --user --format=freeze 2>/dev/null | sed 's/==.*//' | sort -u
    else
        "$_pip" list --format=freeze 2>/dev/null | sed 's/==.*//' | sort -u
    fi
}

list_uv() {
    command -v uv >/dev/null 2>&1 || return 1
    uv tool list 2>/dev/null | awk 'NF && $1 !~ /^-/ { print $1 }' | sort -u
}

uninstall_pkg()  { run_cmd pkg uninstall -y "$1"; }
uninstall_cargo(){ run_cmd cargo uninstall "$1"; }
uninstall_bun()  { run_cmd bun remove -g "$1"; }
uninstall_npm()  { run_cmd npm uninstall -g "$1"; }
uninstall_pip()  {
    _pip=pip3
    command -v pip3 >/dev/null 2>&1 || _pip=pip
    run_cmd "$_pip" uninstall -y "$1"
}
uninstall_uv()   { run_cmd uv tool uninstall "$1"; }

# ---------------------------------------------------------------------------
# interactive picker for one manager
# ---------------------------------------------------------------------------
cleanup_manager() {
    _kind="$1"
    _title="$2"
    _list_fn="$3"
    _rm_fn="$4"

    while :; do
        printf '\n'
        hr
        printf '  %s%s%s\n' "$C_B" "$_title" "$C_RST"
        hr
        _items=()
        while IFS= read -r _line; do
            [ -n "$_line" ] || continue
            _items+=("$_line")
        done < <("$_list_fn" 2>/dev/null || true)

        if [ "${#_items[@]}" -eq 0 ]; then
            warn "Nothing listed (tool missing or no globals)."
            pause
            return 0
        fi

        _i=1
        for _n in "${_items[@]}"; do
            printf '  %2d) %s\n' "$_i" "$_n"
            _i=$((_i + 1))
        done
        printf '\n'
        printf '  Enter numbers (e.g. 1 3 5), %sa%s=all shown, %sb%s=back, %sq%s=quit\n' \
            "$C_B" "$C_RST" "$C_B" "$C_RST" "$C_B" "$C_RST"
        ask '> '
        case "${IVX_REPLY:-}" in
            ''|b|B|back) return 0 ;;
            q|Q|quit|exit) exit 0 ;;
            a|A|all)
                _pick=("${_items[@]}")
                ;;
            *)
                _pick=()
                for _tok in $IVX_REPLY; do
                    case "$_tok" in
                        *[!0-9]*) warn "skip invalid: $_tok"; continue ;;
                    esac
                    _idx=$((_tok))
                    if [ "$_idx" -ge 1 ] && [ "$_idx" -le "${#_items[@]}" ]; then
                        _pick+=("${_items[$((_idx - 1))]}")
                    else
                        warn "out of range: $_tok"
                    fi
                done
                ;;
        esac

        if [ "${#_pick[@]}" -eq 0 ]; then
            warn "nothing selected"
            continue
        fi

        printf '\nRemove:\n'
        for _n in "${_pick[@]}"; do
            printf '  - %s\n' "$_n"
        done
        if [ "$OPT_YES" != 1 ]; then
            ask "Confirm? [y/N] "
            case "${IVX_REPLY:-}" in
                y|Y|yes) : ;;
                *) info "cancelled"; continue ;;
            esac
        fi

        for _n in "${_pick[@]}"; do
            info "removing ($_kind): $_n"
            if "$_rm_fn" "$_n"; then
                ok "  removed $_n"
            else
                err "  failed: $_n"
            fi
        done
        pause
    done
}

menu_main() {
    while :; do
        printf '\n'
        printf '  %sivx-cleanup%s  v%s\n' "$C_B" "$C_RST" "$IVX_CLEANUP_VERSION"
        hr
        printf '   1) Termux pkg          apt-mark showmanual / pkg uninstall\n'
        printf '   2) Cargo               cargo install --list\n'
        printf '   3) Bun global          bun remove -g\n'
        printf '   4) npm global          npm uninstall -g\n'
        printf '   5) pip / pip3          user site\n'
        printf '   6) uv tools            uv tool uninstall\n'
        printf '   q) Quit\n'
        [ "$OPT_DRY" = 1 ] && printf '  %s(dry-run)%s\n' "$C_Y" "$C_RST"
        ask '> '
        case "${IVX_REPLY:-}" in
            1) cleanup_manager pkg "Termux packages" list_pkg uninstall_pkg ;;
            2) cleanup_manager cargo "Cargo binaries" list_cargo uninstall_cargo ;;
            3) cleanup_manager bun "Bun globals" list_bun uninstall_bun ;;
            4) cleanup_manager npm "npm globals" list_npm uninstall_npm ;;
            5) cleanup_manager pip "pip packages" list_pip uninstall_pip ;;
            6) cleanup_manager uv "uv tools" list_uv uninstall_uv ;;
            q|Q|quit|exit) printf '\n'; return 0 ;;
            '') : ;;
            *) warn "unknown choice: $IVX_REPLY" ;;
        esac
    done
}

cmd_help() {
    cat <<EOF
ivx-cleanup — interactive cleanup for global installs

Usage:
  ivx-cleanup                 interactive menu
  ivx-cleanup pkg|cargo|bun|npm|pip|uv
  ivx-cleanup help

Flags:
  -y, --yes       skip confirm prompts
  --dry-run       print uninstall commands only
  --no-color      disable ANSI colours

Managers:
  pkg     apt-mark showmanual → pkg uninstall -y
  cargo   cargo install --list → cargo uninstall
  bun     ~/.bun/install/global → bun remove -g
  npm     npm list -g → npm uninstall -g
  pip     pip list --user → pip uninstall -y
  uv      uv tool list → uv tool uninstall
EOF
}

_cmd=${1:-menu}
[ $# -gt 0 ] && shift

case "$_cmd" in
    menu) menu_main ;;
    pkg|apt) cleanup_manager pkg "Termux packages" list_pkg uninstall_pkg ;;
    cargo) cleanup_manager cargo "Cargo binaries" list_cargo uninstall_cargo ;;
    bun) cleanup_manager bun "Bun globals" list_bun uninstall_bun ;;
    npm) cleanup_manager npm "npm globals" list_npm uninstall_npm ;;
    pip|pip3) cleanup_manager pip "pip packages" list_pip uninstall_pip ;;
    uv) cleanup_manager uv "uv tools" list_uv uninstall_uv ;;
    help|-h|--help) cmd_help ;;
    *)
        err "unknown command: $_cmd"
        cmd_help
        exit 2
        ;;
esac
