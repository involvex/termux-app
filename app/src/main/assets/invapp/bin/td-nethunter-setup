#!@BASH@
# InVxTermux — NetHunter on udocker (device-only).
# Default: download the official Kali NetHunter rootfs from kali.download
# (same images as KeX / install-nethunter-termux), install rootfs+proot, then
# install TigerVNC + a minimal desktop. Docker Hub pulls are optional/fallback
# because they often fail on Android ("manifest not found or not authorized").
#
# Usage:
#   td-nethunter-setup                         # nano rootfs + VNC stack
#   td-nethunter-setup --variant minimal|full
#   td-nethunter-setup --from-tar FILE
#   td-nethunter-setup --from-docker-save FILE
#   td-nethunter-setup --docker [image]        # try Hub (usually broken)
#
# After: td-nethunter → AVNC/KeX to 127.0.0.1:5901 ; td-udocker for a shell
# rev: 2026.11.03-1
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

MODE="nethunter"
VARIANT="${TD_NETHUNTER_VARIANT:-nano}"
FROM_FILE=""
IMAGE="${TD_UDOCKER_IMAGE:-kalilinux/kali-rolling}"
NAME="${TD_UDOCKER_NAME_OVERRIDE:-${TD_UDOCKER_NAME:-kali}}"
STATE_DIR="${TD_UDOCKER_STATE:-$PREFIX/var/td-udocker}"
SETUP="$PREFIX/bin/td-udocker-setup"

log() { printf 'td-nethunter-setup: %s\n' "$*"; }
die() { printf 'td-nethunter-setup: ERROR: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      echo "Usage: td-nethunter-setup [--variant nano|minimal|full]"
      echo "       td-nethunter-setup --from-tar FILE"
      echo "       td-nethunter-setup --from-docker-save FILE"
      echo "       td-nethunter-setup --docker [image]"
      exit 0
      ;;
    --variant|-v)
      shift
      [ $# -gt 0 ] || die "--variant needs nano|minimal|full"
      VARIANT="$1"; shift
      MODE="nethunter"
      ;;
    --from-tar)
      MODE="from-tar"
      shift
      [ $# -gt 0 ] || die "--from-tar needs a file"
      FROM_FILE="$1"; shift
      ;;
    --from-docker-save)
      MODE="from-docker-save"
      shift
      [ $# -gt 0 ] || die "--from-docker-save needs a file"
      FROM_FILE="$1"; shift
      ;;
    --docker|--hub)
      MODE="docker"
      shift
      [ $# -gt 0 ] && { IMAGE="$1"; shift; }
      ;;
    nano|minimal|full)
      VARIANT="$1"; MODE="nethunter"; shift
      ;;
    *)
      die "unknown arg: $1 (try --help)"
      ;;
  esac
done

if [ "${INVAPP_ON_DEVICE:-0}" != 1 ]; then
  log "device-only helper"
  echo "  Reopen InVxTermux on the phone and run: td-nethunter-setup" >&2
  exit 1
fi

log "rev 2026.11.03-1 (mode=$MODE → $NAME)"
[ -x "$SETUP" ] || die "td-udocker-setup missing — reopen the app to reseed helpers"

case "$MODE" in
  nethunter)
    TD_UDOCKER_NAME_OVERRIDE="$NAME" "$SETUP" --nethunter "$VARIANT" \
      || die "td-udocker-setup --nethunter failed"
    ;;
  from-tar)
    TD_UDOCKER_NAME_OVERRIDE="$NAME" "$SETUP" --from-tar "$FROM_FILE" \
      || die "td-udocker-setup --from-tar failed"
    ;;
  from-docker-save)
    TD_UDOCKER_NAME_OVERRIDE="$NAME" "$SETUP" --from-docker-save "$FROM_FILE" \
      || die "td-udocker-setup --from-docker-save failed"
    ;;
  docker)
    log "trying Docker Hub (often fails on Android — prefer default --nethunter)"
    TD_UDOCKER_NAME_OVERRIDE="$NAME" "$SETUP" "$IMAGE" \
      || die "Hub pull failed — run: td-nethunter-setup   # uses kali.download"
    ;;
esac

td_udocker_ready "$NAME" || die "container '$NAME' not ready after udocker setup"
mkdir -p "$STATE_DIR"
APT_LOG="$STATE_DIR/$NAME.apt-install.log"

log "installing VNC stack inside $NAME (apt; first run can take a while)…"
if ! td_udocker_run "$NAME" /bin/sh -c '
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y --no-install-recommends \
      tigervnc-standalone-server tigervnc-tools tigervnc-common \
      openbox obconf xterm dbus-x11 x11-xserver-utils xfonts-base \
      xfce4 xfce4-goodies 2>/dev/null \
    || apt-get install -y --no-install-recommends \
      tigervnc-standalone-server openbox xterm dbus-x11 2>/dev/null \
    || apt-get install -y --no-install-recommends \
      tightvncserver openbox xterm 2>/dev/null \
    || apt-get install -y tigervnc-standalone-server tigervnc openbox xterm
' >"$APT_LOG" 2>&1; then
  if [ -s "$APT_LOG" ]; then
    echo "td-nethunter-setup: apt log tail:" >&2
    tail -20 "$APT_LOG" >&2
  fi
  die "VNC stack install failed inside $NAME"
fi

case "$NAME" in
  kali*)
    log "installing NetHunter helpers (nethunter-utils, best effort)…"
    if td_udocker_run "$NAME" \
        apt-get install -y --no-install-recommends nethunter-utils \
        >>"$APT_LOG" 2>&1; then
      log "NetHunter CLI helpers installed"
    else
      log "nethunter-utils not available — kali base desktop only"
    fi
    ;;
esac

log "writing ~/.vnc/xstartup"
td_udocker_run "$NAME" /bin/sh -c 'mkdir -p /root/.vnc && cat > /root/.vnc/xstartup && chmod +x /root/.vnc/xstartup' <<'XSTARTUP'
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
export XKL_XMODMAP_DISABLE=1
[ -r "$HOME/.Xresources" ] && xrdb "$HOME/.Xresources"
xsetroot -solid grey &
if command -v startxfce4 >/dev/null 2>&1; then
  exec startxfce4
elif command -v xfce4-session >/dev/null 2>&1; then
  exec xfce4-session
elif command -v openbox-session >/dev/null 2>&1; then
  exec openbox-session
else
  openbox &
  xterm &
  sleep infinity
fi
XSTARTUP

HAS_PASS=0
if td_udocker_run "$NAME" /bin/sh -c \
  'test -f /root/.vnc/passwd -o -f /root/.vnc/passwd.vnc' >/dev/null 2>&1; then
  HAS_PASS=1
fi
if [ "$HAS_PASS" != 1 ]; then
  log "set a VNC password (required by most viewers; do not leave blank)"
  if [ -t 0 ]; then
    td_udocker_run "$NAME" /bin/sh -c '
      if command -v vncpasswd >/dev/null 2>&1; then
        vncpasswd
      else
        echo "vncpasswd missing — install tigervnc-tools and re-run setup" >&2
        exit 1
      fi
    ' || log "vncpasswd skipped/failed — run later: td-udocker vncpasswd"
  else
    log "no TTY — set password later: td-udocker vncpasswd"
  fi
fi

touch "$STATE_DIR/$NAME.nethunter.ready"
log "$NAME ready — start desktop: td-nethunter"
log "connect with AVNC / RealVNC / KeX to 127.0.0.1:5901 (after td-nethunter)"
log "shell: td-udocker"
