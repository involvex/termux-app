#!@BASH@
# InVxTermux — td-ai-stop
# Stops the OpenCode service started by td-ai / opencode-server.
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

if command -v opencode-server >/dev/null 2>&1; then
    exec opencode-server stop
fi

killed=0
if command -v opencode >/dev/null 2>&1 && opencode service --help >/dev/null 2>&1; then
    opencode service stop 2>/dev/null && killed=1
fi
pkill -f '[o]pencode serve' 2>/dev/null && killed=1
pkill -f '[o]pencode web' 2>/dev/null && killed=1

sleep 1
if [ "$killed" = 1 ]; then
    echo "td-ai-stop: stopped OpenCode"
else
    echo "td-ai-stop: no OpenCode server was running"
fi
