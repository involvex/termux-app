#!@BASH@
# InVxTermux — alias for td-udocker (udocker container shell / one-shot).
# Kept so muscle memory and older docs still work after the proot-distro →
# udocker refactor. Usage: td-guest [name] [cmd...]
# rev: 2026.10.30-1
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

# Prefer the seeded sibling; fall back to PATH.
_self="$(command -v td-udocker 2>/dev/null || true)"
if [ -z "$_self" ] && [ -x "$PREFIX/bin/td-udocker" ]; then
  _self="$PREFIX/bin/td-udocker"
fi
if [ -z "$_self" ]; then
  echo "td-guest: td-udocker missing — reopen the app (helper reseed) or run td-udocker-setup" >&2
  exit 127
fi
exec "$_self" "$@"
