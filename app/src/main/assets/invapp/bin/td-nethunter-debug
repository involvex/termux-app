#!@BASH@
# InVxTermux — NetHunter self-test (device-only; rootfs or udocker backend).
# Paste the whole output on failure. Usage: td-nethunter-debug [name]
# rev: 2026.11.03-1
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

NAME="${1:-${TD_UDOCKER_NAME:-kali}}"
STATE_DIR="${TD_UDOCKER_STATE:-$PREFIX/var/td-udocker}"
DISPLAY_NUM="${TD_NETHUNTER_DISPLAY:-1}"
VNCPORT=$((5900 + DISPLAY_NUM))
UDIR="${UDOCKER_DIR:-${HOME:-$PREFIX/../home}/.udocker}"

h() { printf '\n== %s\n' "$*"; }
ok() { printf 'OK: %s\n' "$*"; }
bad() { printf 'FAIL: %s\n' "$*"; }

h "environment"
echo "PREFIX=$PREFIX"
echo "HOME=${HOME-<unset>}"
echo "LD_PRELOAD=${LD_PRELOAD-<unset>}"
echo "PROOT_NO_SECCOMP=${PROOT_NO_SECCOMP-<unset>}"
echo "INVAPP_ON_DEVICE=${INVAPP_ON_DEVICE-<unset>}"
echo "TD_UDOCKER_IMAGE=${TD_UDOCKER_IMAGE-<unset>}"
echo "TD_UDOCKER_NAME=${TD_UDOCKER_NAME-<unset>}"
echo "UDOCKER_DIR=$UDIR"
echo "uname=$(uname -a)"

h "tools"
for t in udocker proot python python3 bash curl; do
  printf '%-14s %s\n' "$t" "$(command -v "$t" 2>/dev/null || echo MISSING)"
done

h "proot ELF check"
if [ -f "$PREFIX/bin/proot" ]; then
  ls -l "$PREFIX/bin/proot"
  if head -c 4 "$PREFIX/bin/proot" 2>/dev/null | od -An -tx1 | grep -q '7f 45 4c 46'; then
    ok "proot is ELF"
    proot --version 2>&1 | head -3 || true
  else
    bad "proot is NOT an ELF (pip shim?) — pkg reinstall proot"
  fi
else
  bad "proot missing"
fi

h "udocker --version"
if command -v udocker >/dev/null 2>&1; then
  udocker --version 2>&1 | head -5 || true
  ok "udocker present"
else
  bad "udocker missing — run: td-udocker-setup"
fi

h "udocker.conf (killonexit should be False)"
if [ -f "$UDIR/udocker.conf" ]; then
  cat "$UDIR/udocker.conf"
else
  bad "no $UDIR/udocker.conf — td_udocker_conf_init not run yet"
fi

h "backend $NAME"
_be="$(td_udocker_backend "$NAME" 2>/dev/null || true)"
echo "backend=${_be:-none}"
_rfs="$(td_udocker_rootfs_dir "$NAME")"
if [ -d "$_rfs" ]; then
  ok "rootfs dir $_rfs"
  ls -la "$_rfs/bin/sh" "$_rfs/bin/bash" 2>&1 | head -5 || true
else
  echo "(no $_rfs — expected for udocker-only guests)"
fi

h "udocker images / ps (optional)"
if command -v udocker >/dev/null 2>&1; then
  udocker images 2>&1 | head -20 || true
  udocker ps 2>&1 | head -20 || true
  if udocker inspect "$NAME" >/dev/null 2>&1; then
    ok "udocker container $NAME exists"
    udocker inspect "$NAME" 2>&1 | head -40
  else
    echo "(no udocker container named $NAME)"
  fi
else
  echo "udocker not installed (ok for kali.download rootfs path)"
fi

h "guest exists?"
if td_udocker_container_exists "$NAME" 2>/dev/null; then
  ok "guest $NAME present (backend=${_be:-?})"
else
  bad "guest $NAME missing — run: td-nethunter-setup"
fi

h "ready markers"
for f in "$STATE_DIR/$NAME.ready" "$STATE_DIR/$NAME.nethunter.ready" "$STATE_DIR/$NAME.image" "$STATE_DIR/$NAME.backend"; do
  if [ -e "$f" ]; then ok "$f"; [ -f "$f" ] && head -1 "$f"; else bad "missing $f"; fi
done

h "redirector (com.termux path rewrite)"
if [ -n "${LD_PRELOAD:-}" ]; then
  ok "LD_PRELOAD set (needed for Termux udocker hardcoded com.termux proot path)"
  echo "LD_PRELOAD=$LD_PRELOAD"
else
  bad "LD_PRELOAD empty — path redirector may be inactive; reopen app / new session"
fi
# Termux udocker patches often hardcode stock prefix; redirector maps it.
_stock_proot="/data/data/com.termux/files/usr/bin/proot"
_fork_proot="$PREFIX/bin/proot"
echo "stock path (redirect target): $_stock_proot"
echo "fork proot: $_fork_proot ($( [ -x "$_fork_proot" ] && echo present || echo MISSING ))"

h "one-shot run $NAME /bin/true"
export PROOT_NO_SECCOMP="${PROOT_NO_SECCOMP:-1}"
if td_udocker_run "$NAME" /bin/true; then
  ok "run /bin/true"
elif td_udocker_run "$NAME" /bin/sh -c true; then
  ok "run /bin/sh -c true"
else
  bad "guest not runnable"
fi

h "os-release (guest)"
td_udocker_run "$NAME" /bin/sh -c 'cat /etc/os-release 2>/dev/null | head -8' 2>&1 | head -12 || true

h "VNC binaries (guest)"
td_udocker_run "$NAME" /bin/sh -c '
  for c in Xtigervnc Xvnc vncserver vncpasswd; do
    printf "%-12s %s\n" "$c" "$(command -v $c 2>/dev/null || echo MISSING)"
  done
  ls -l /root/.vnc/xstartup 2>/dev/null || echo "no xstartup"
' 2>&1 | head -20 || true

h "listen 127.0.0.1:$VNCPORT"
if (exec 3<>/dev/tcp/127.0.0.1/"$VNCPORT") 2>/dev/null; then
  ok "VNC port open — connect AVNC to 127.0.0.1:$VNCPORT"
else
  bad "nothing on :$VNCPORT — run: td-nethunter"
fi

h "done"
echo "If pull/create fails with SSL/grp errors on python 3.13, see Termux udocker issues;"
echo "path errors mentioning com.termux need LD_PRELOAD=libinvapp-redirector.so."
