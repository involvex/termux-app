#!@BASH@
# InVxTermux — start TigerVNC inside the udocker Kali (NetHunter) container.
# Usage: td-nethunter [name] [display]   |   td-nethunter --stop [name]
#   name     container (default: kali)
#   display  VNC display number (default: TD_NETHUNTER_DISPLAY or 1 → :5901)
# Starts Xvnc/vncserver on 127.0.0.1:$((5900+display)). Connect with AVNC /
# RealVNC / NetHunter KeX — Preview/noVNC is not used.
# Requires: td-nethunter-setup
# rev: 2026.10.30-1
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

NAME="${TD_UDOCKER_NAME:-kali}"
DISPLAY_NUM="${TD_NETHUNTER_DISPLAY:-1}"
STATE_DIR="${TD_UDOCKER_STATE:-$PREFIX/var/td-udocker}"
STOP=0

log() { printf 'td-nethunter: %s\n' "$*"; }
die() { printf 'td-nethunter: ERROR: %s\n' "$*" >&2; exit 1; }

# Parse: --stop [name]  |  [name] [display]
while [ $# -gt 0 ]; do
  case "$1" in
    --stop|-s) STOP=1; shift ;;
    -*) die "unknown option: $1" ;;
    *) break ;;
  esac
done
if [ $# -gt 0 ]; then
  NAME="$1"
  shift
fi
if [ $# -gt 0 ]; then
  DISPLAY_NUM="$1"
  shift
fi
VNCPORT=$((5900 + DISPLAY_NUM))
PIDFILE="$STATE_DIR/$NAME.vnc.pid"
VNCLOG="$STATE_DIR/$NAME.vnc-start.log"

vnc_listening() { (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null; }

if [ "$STOP" = 1 ]; then
  if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ -n "$pid" ]; then
      kill "$pid" 2>/dev/null && log "stopped keep-alive (pid $pid)" || true
    fi
    rm -f "$PIDFILE"
  fi
  if td_udocker_container_exists "$NAME" 2>/dev/null; then
    td_udocker_run "$NAME" /bin/sh -c "
      vncserver -kill :$DISPLAY_NUM >/dev/null 2>&1 || true
      pkill -f 'Xtigervnc.*:$DISPLAY_NUM' 2>/dev/null || true
      pkill -f 'Xvnc.*:$DISPLAY_NUM' 2>/dev/null || true
    " >/dev/null 2>&1 || true
  fi
  log "VNC stop requested for $NAME :$DISPLAY_NUM (was 127.0.0.1:$VNCPORT)"
  exit 0
fi

if [ "${INVAPP_ON_DEVICE:-0}" != 1 ]; then
  log "device-only — reopen InVxTermux: td-nethunter" >&2
  exit 1
fi

log "rev 2026.10.30-1 (udocker VNC → $NAME :$DISPLAY_NUM)"

td_udocker_nethunter_ready "$NAME" || {
  log "$NAME NetHunter stack missing — run: td-nethunter-setup" >&2
  exit 1
}
td_udocker_ensure_proot || die "proot repair failed"
mkdir -p "$STATE_DIR"

if vnc_listening "$VNCPORT"; then
  log "VNC already listening on 127.0.0.1:$VNCPORT"
else
  log "starting VNC on $NAME :$DISPLAY_NUM → 127.0.0.1:$VNCPORT"
  # proot_killonexit=False (udocker.conf) lets the Xvnc daemon outlive this run.
  _vnc_cmd="
    chmod +x /root/.vnc/xstartup 2>/dev/null || true
    mkdir -p /root/.vnc
    if command -v Xtigervnc >/dev/null 2>&1; then
      Xtigervnc :$DISPLAY_NUM -localhost yes -geometry 1280x720 -depth 24 \
        -desktop td-nethunter -xstartup /root/.vnc/xstartup \
        >/root/.td-nethunter-vnc.log 2>&1 &
    elif command -v Xvnc >/dev/null 2>&1; then
      Xvnc :$DISPLAY_NUM -localhost yes -geometry 1280x720 -depth 24 \
        -desktop td-nethunter -xstartup /root/.vnc/xstartup \
        >/root/.td-nethunter-vnc.log 2>&1 &
    elif command -v vncserver >/dev/null 2>&1; then
      vncserver -kill :$DISPLAY_NUM >/dev/null 2>&1 || true
      vncserver :$DISPLAY_NUM -geometry 1280x720 -depth 24 -localhost yes \
        -xstartup /root/.vnc/xstartup >/root/.td-nethunter-vnc.log 2>&1
    else
      echo NO_VNC_SERVER_FOUND >>/root/.td-nethunter-vnc.log
      exit 1
    fi
    sleep 2
  "
  td_udocker_run "$NAME" /bin/sh -c "$_vnc_cmd" >"$VNCLOG" 2>&1 || true
  _i=0
  while [ "$_i" -lt 25 ] && ! vnc_listening "$VNCPORT"; do
    sleep 1
    _i=$((_i + 1))
  done
  if vnc_listening "$VNCPORT"; then
    log "VNC listening on 127.0.0.1:$VNCPORT"
  else
    log "VNC did not come up — launcher log:"
    [ -s "$VNCLOG" ] && tail -20 "$VNCLOG" >&2
    log "  guest log: td-udocker $NAME cat /root/.td-nethunter-vnc.log"
    log "  debug:     td-nethunter-debug $NAME"
    exit 1
  fi
fi

# Record a marker pidfile (host has no long-lived bridge process anymore).
echo "vnc:$VNCPORT" >"$PIDFILE"

log "connect with a VNC client:"
echo "  address: 127.0.0.1"
echo "  port:    $VNCPORT"
echo "  apps:    AVNC, RealVNC Viewer, or NetHunter KeX"
echo "  stop:    td-nethunter --stop $NAME"
echo "  shell:   td-udocker $NAME"
