#!@BASH@
# InVxTermux — run a proot-distro desktop and bridge it to a noVNC client on
# Preview/LAN.  Usage:  td-nethunter [distro] [port]   |   td-nethunter --stop
#   distro  OCI ref for proot-distro (default: Kali NetHunter kali-rolling);
#           also: ubuntu:22.04  ubuntu:24.04  debian:12
#   port    host TCP port for the noVNC bridge (default 6080)
# The VNC server is display :1 (127.0.0.1:5901) in the shared netns (proot-distro
# does not isolate the network). websockify bridges WS<->VNC and also serves the
# noVNC client, so the Preview/LAN URL is <host>:<port>/vnc.html.
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

DISTRO_IMAGE="$1"
PORT="${2:-6080}"
STATE_DIR="$PREFIX/var/td-nethunter"
NOVNC_DIR="$STATE_DIR/novnc"
WS_DIR="$STATE_DIR/websockify"
WS_REPO="$WS_DIR/websockify-master"   # repo root (contains the websockify/ package)
DISPLAY_NUM="${TD_NETHUNTER_DISPLAY:-1}"
VNCPORT=$((5900 + DISPLAY_NUM))
PIDFILE="$STATE_DIR/websockify.pid"

log() { printf 'td-nethunter: %s\n' "$*"; }
die() { printf 'td-nethunter: ERROR: %s\n' "$*" >&2; exit 1; }

# proot-distro login execs $PREFIX/bin/proot; a pip shim can shadow it.
ensure_real_proot() {
  p="$PREFIX/bin/proot"
  if [ ! -f "$p" ]; then
    log "installing proot (missing)"
    pkg install -y proot || die "pkg install proot failed"
  elif ! head -c 4 "$p" 2>/dev/null | od -An -tx1 | grep -q '7f 45 4c 46'; then
    log "rogue 'proot' shim at $p (not an ELF binary) — reinstalling proot"
    pkg reinstall -y proot 2>/dev/null \
      || apt-get install -y --reinstall proot \
      || { rm -f "$p"; pkg install -y proot; } \
      || die "proot repair failed"
  fi
  "$p" --version >/dev/null 2>&1 \
    || die "proot at $p still unusable — try: pip uninstall proot && pkg install -y -f proot"
}

# --- --stop: kill the noVNC bridge (pidfile). Distro VNC is left alone;
# tear it with `proot-distro destroy <name>`.
if [ "$DISTRO_IMAGE" = "--stop" ] || [ "$DISTRO_IMAGE" = "-s" ]; then
  if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ -n "$pid" ]; then kill "$pid" 2>/dev/null && log "stopped noVNC bridge (pid $pid)"; fi
    rm -f "$PIDFILE"
  else
    log "nothing to stop (no pidfile)"
  fi
  log "distro VNC still on 127.0.0.1:$VNCPORT — run: proot-distro destroy"
  exit 0
fi

# --- device-only (container twin deferred) ---
if [ "${INVAPP_ON_DEVICE:-0}" != 1 ]; then
  log "device-only — Reopen InVxTermux on the phone: td-nethunter ${1:-kalilinux/kali-rolling} ${PORT}" >&2
  exit 1
fi

DISTRO_IMAGE="${DISTRO_IMAGE:-kalilinux/kali-rolling}"
# Container name proot-distro derives from the image ref (tag + path stripped).
DISTRO_NAME="${DISTRO_IMAGE##*/}"
DISTRO_NAME="${DISTRO_NAME%%:*}"

# Sanity gates before launching.
[ -f "$STATE_DIR/$DISTRO_NAME.ready" ] || {
  log "$DISTRO_NAME not set up — run: td-nethunter-setup $DISTRO_IMAGE" >&2
  exit 1
}
command -v python3 >/dev/null 2>&1 || {
  log "python3 missing — run: pkg install python" >&2
  exit 1
}
[ -d "$WS_REPO/websockify" ] || {
  log "websockify missing — run: td-nethunter-setup $DISTRO_IMAGE" >&2
  exit 1
}
[ -f "$NOVNC_DIR/vnc.html" ] || {
  log "noVNC missing — run: td-nethunter-setup $DISTRO_IMAGE" >&2
  exit 1
}

# Start the distro VNC server unless something is already on 127.0.0.1:$VNCPORT.
# proot-distro shares the netns, so the port is reachable from Termux itself.
vnc_listening() { (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null; }
ensure_real_proot
if ! vnc_listening "$VNCPORT"; then
  log "starting VNC on $DISTRO_NAME :$DISPLAY_NUM -> 127.0.0.1:$VNCPORT"
  # Xtigervnc directly: the vncserver wrapper needs ssh, which the distro lacks.
  # -SecurityTypes None = no password (localhost-only, so the desktop is not
  # reachable off-device); -desktop names the session (xstartup runs openbox).
  proot-distro login "$DISTRO_NAME" -- Xtigervnc ":$DISPLAY_NUM" -localhost \
    -SecurityTypes None -geometry 1280x720 -depth 24 -desktop td-nethunter 2>/dev/null \
    || log "VNC start failed (already running, or Xtigervnc missing in $DISTRO_NAME)"
else
  log "VNC already listening on 127.0.0.1:$VNCPORT"
fi

log "noVNC bridge -> 0.0.0.0:$PORT  (VNC 127.0.0.1:$VNCPORT)"
echo "  When the port appears: drawer -> Preview -> Scan"
echo "  open /vnc.html   (or Copy LAN: http://<wifi-ip>:$PORT/vnc.html)"

# websockify bridges WS<->VNC and serves the noVNC client: the listen address
# and VNC target are POSITIONAL ([source_addr:]source_port target_addr:target_port);
# there is no --listen flag. PYTHONPATH=WS_REPO so `python3 -m websockify` finds
# the unpacked package dir.
echo $$ > "$PIDFILE"
exec env PYTHONPATH="$WS_REPO${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m websockify \
    --web "$NOVNC_DIR" "0.0.0.0:$PORT" "127.0.0.1:$VNCPORT"