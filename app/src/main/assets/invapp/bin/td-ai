#!@BASH@
# InVxTermux — td-ai [port]
# Thin alias → opencode-server (OpenCode V2 background service, default :4000).
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

if ! command -v opencode-server >/dev/null 2>&1; then
    echo "td-ai: opencode-server missing — reopen the app once" >&2
    exit 127
fi
exec opencode-server "$@"
