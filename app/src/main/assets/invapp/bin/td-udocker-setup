#!@BASH@
# InVxTermux — optional udocker install + pull/create/import (device-only).
# Usage:
#   td-udocker-setup [image]                 # Hub pull (often broken on Android)
#   td-udocker-setup --nethunter [variant]   # official kali.download rootfs (recommended)
#   td-udocker-setup --from-tar FILE         # import rootfs / docker export tarball
#   td-udocker-setup --from-docker-save FILE # load `docker save` from a PC
#
# Hub pulls of kalilinux/* frequently fail on Termux ("manifest not found or
# not authorized") even with --platform=linux/arm64 — registry/SSL quirks.
# Prefer --nethunter (KeX rootfs) or a PC docker save.
# --nethunter / --from-tar install a persistent rootfs + direct proot (not
# `udocker import` — that re-extracts layers and breaks on this fork).
#
# Name override: TD_UDOCKER_NAME_OVERRIDE=foo
# rev: 2026.11.03-1
. "${INVAPP_LIB_DIR:-$PREFIX/lib/invapp}/env.sh"

MODE="hub"
IMAGE_IN="${TD_UDOCKER_IMAGE:-kalilinux/kali-rolling}"
VARIANT="${TD_NETHUNTER_VARIANT:-nano}"
FROM_FILE=""
NAME="${TD_UDOCKER_NAME:-kali}"
STATE_DIR="${TD_UDOCKER_STATE:-$PREFIX/var/td-udocker}"

log() { printf 'td-udocker-setup: %s\n' "$*"; }
die() { printf 'td-udocker-setup: ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: td-udocker-setup [options] [image|variant]
  (default)              try Docker Hub pull of kalilinux/kali-rolling:arm64
  --nethunter [variant]  download official NetHunter rootfs (nano|minimal|full)
  --from-tar FILE        import a rootfs / docker-export tarball (.tar[.gz|.xz])
  --from-docker-save FILE
                         load a `docker save` image tarball from a PC
  --name NAME            container name (default: kali)
  -h, --help             this help

PC transfer (when Hub pull fails on phone):
  docker pull --platform linux/arm64 kalilinux/kali-rolling:arm64
  docker save -o kali-arm64.tar kalilinux/kali-rolling:arm64
  # copy kali-arm64.tar to the phone, then:
  td-udocker-setup --from-docker-save /path/to/kali-arm64.tar

Proot/NetHunter rootfs tarballs must contain bin/sh at the filesystem root
(or a single top-level kali-arm64/ dir). A wrong nesting → missing /bin/sh.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --nethunter|--rootfs)
      MODE="nethunter"
      shift
      if [ $# -gt 0 ] && case "$1" in nano|minimal|full) true ;; *) false ;; esac; then
        VARIANT="$1"; shift
      fi
      ;;
    --from-tar|--import)
      MODE="from-tar"
      shift
      [ $# -gt 0 ] || die "--from-tar needs a file path"
      FROM_FILE="$1"; shift
      ;;
    --from-docker-save|--load)
      MODE="from-docker-save"
      shift
      [ $# -gt 0 ] || die "--from-docker-save needs a file path"
      FROM_FILE="$1"; shift
      ;;
    --name)
      shift
      [ $# -gt 0 ] || die "--name needs a value"
      NAME="$1"; shift
      ;;
    -*)
      die "unknown option: $1 (try --help)"
      ;;
    *)
      if [ "$MODE" = "nethunter" ]; then
        VARIANT="$1"
      else
        IMAGE_IN="$1"
        NAME="${TD_UDOCKER_NAME_OVERRIDE:-$(td_udocker_name_from_image "$IMAGE_IN")}"
      fi
      shift
      ;;
  esac
done

[ -n "${TD_UDOCKER_NAME_OVERRIDE:-}" ] && NAME="$TD_UDOCKER_NAME_OVERRIDE"

if [ "${INVAPP_ON_DEVICE:-0}" != 1 ]; then
  log "device-only helper"
  echo "  Reopen InVxTermux on the phone and run: td-udocker-setup --help" >&2
  exit 1
fi

log "rev 2026.11.03-1 (mode=$MODE name=$NAME)"
PLAT="$(td_udocker_platform)"
log "platform $PLAT"

command -v tar >/dev/null 2>&1 || pkg install -y tar || die "need tar"
command -v xz >/dev/null 2>&1 || command -v xzcat >/dev/null 2>&1 \
  || pkg install -y xz-utils 2>/dev/null || true

# Hub / docker-save need udocker; NetHunter rootfs only needs proot+tar.
case "$MODE" in
  hub|from-docker-save)
    command -v udocker >/dev/null 2>&1 || {
      log "installing udocker (pulls proot/python/resolv-conf as deps)"
      pkg install -y --no-install-recommends udocker \
        || die "pkg install udocker failed"
    }
    pkg upgrade -y udocker 2>/dev/null || true
    td_udocker_ensure || die "udocker not on PATH after install"
    td_udocker_conf_init
    ;;
  nethunter|from-tar)
    command -v proot >/dev/null 2>&1 || pkg install -y proot || die "need proot"
    # Best-effort: drop a broken half-imported udocker "kali" if present.
    command -v udocker >/dev/null 2>&1 && td_udocker_conf_init || true
    ;;
esac
td_udocker_ensure_proot || die "proot repair failed"
mkdir -p "$STATE_DIR"

mark_ready() {
  _src="${1:-unknown}"
  printf '%s\n' "$_src" >"$STATE_DIR/$NAME.image"
  touch "$STATE_DIR/$NAME.ready"
}

probe_or_die() {
  PROBE_LOG="$STATE_DIR/$NAME.probe.log"
  if ! td_udocker_run "$NAME" /bin/true >"$PROBE_LOG" 2>&1 \
    && ! td_udocker_run "$NAME" /bin/sh -c true >"$PROBE_LOG" 2>&1 \
    && ! td_udocker_run "$NAME" /bin/bash -c true >"$PROBE_LOG" 2>&1; then
    echo "td-udocker-setup: probe log tail:" >&2
    tail -20 "$PROBE_LOG" >&2
    die "container '$NAME' not runnable — missing /bin/sh? see docs/nethunter.md"
  fi
}

case "$MODE" in
  nethunter)
    log "NetHunter rootfs variant=$VARIANT arch=$(td_nethunter_arch)"
    ARCHIVE="$(td_nethunter_download_rootfs "$VARIANT")" \
      || die "download failed — check network / TD_NETHUNTER_ROOTFS_BASE"
    log "installing $ARCHIVE → rootfs $NAME (direct proot, not udocker import)"
    # Drop a previous failed import so probe does not hit a broken container.
    rm -rf "$STATE_DIR/rootfs/$NAME" "$STATE_DIR/$NAME.backend"
    td_udocker_install_rootfs_tar "$ARCHIVE" "$NAME" \
      || die "rootfs install failed"
    mark_ready "nethunter:$VARIANT:$(td_nethunter_arch)"
    ;;
  from-tar)
    [ -f "$FROM_FILE" ] || die "file not found: $FROM_FILE"
    log "installing rootfs tar $FROM_FILE → $NAME (direct proot)"
    rm -rf "$STATE_DIR/rootfs/$NAME" "$STATE_DIR/$NAME.backend"
    td_udocker_install_rootfs_tar "$FROM_FILE" "$NAME" \
      || die "rootfs install failed (need bin/sh at archive root or kali-arm64/…)"
    mark_ready "tar:$FROM_FILE"
    ;;
  from-docker-save)
    [ -f "$FROM_FILE" ] || die "file not found: $FROM_FILE"
    log "loading docker-save $FROM_FILE → $NAME"
    td_udocker_load_docker_save "$FROM_FILE" \
      "$(td_udocker_resolve_image "$IMAGE_IN")" "$NAME" \
      || die "udocker load failed"
    mark_ready "docker-save:$FROM_FILE"
    ;;
  hub)
    IMAGE="$(td_udocker_resolve_image "$IMAGE_IN")"
    NAME="${TD_UDOCKER_NAME_OVERRIDE:-$(td_udocker_name_from_image "$IMAGE_IN")}"
    if td_udocker_container_exists "$NAME"; then
      log "container '$NAME' already exists — skipping create"
      mark_ready "$IMAGE"
    else
      log "pulling $IMAGE (platform $PLAT) …"
      if ! td_udocker_pull "$IMAGE_IN"; then
        echo "td-udocker-setup: Docker Hub pull failed on this device." >&2
        echo "  Recommended (no Hub):" >&2
        echo "    td-udocker-setup --nethunter nano" >&2
        echo "    td-nethunter-setup" >&2
        echo "  Or pull on a PC and transfer:" >&2
        echo "    docker pull --platform $PLAT $IMAGE" >&2
        echo "    docker save -o kali.tar $IMAGE" >&2
        echo "    td-udocker-setup --from-docker-save kali.tar" >&2
        die "udocker pull failed for $IMAGE_IN"
      fi
      IMAGE="${TD_UDOCKER_LAST_PULLED:-$IMAGE}"
      log "pulled $IMAGE — creating --name=$NAME"
      PROOT_NO_SECCOMP="${PROOT_NO_SECCOMP:-1}" \
        udocker create --name="$NAME" "$IMAGE" \
        || die "udocker create failed for $IMAGE"
      PROOT_NO_SECCOMP="${PROOT_NO_SECCOMP:-1}" \
        udocker setup --execmode=P1 "$NAME" 2>/dev/null || true
      mark_ready "$IMAGE"
    fi
    ;;
esac

td_udocker_container_exists "$NAME" \
  || die "guest '$NAME' missing after setup — see docs/nethunter.md"
probe_or_die

_be="$(td_udocker_backend "$NAME" 2>/dev/null || true)"
log "ready (backend=${_be:-?}) — run: td-udocker $NAME"
log "NetHunter desktop (VNC): td-nethunter-setup"
log "orphan proot-distro trees (if any): \$PREFIX/var/lib/proot-distro/ — safe to remove"
