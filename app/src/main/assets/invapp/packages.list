# InVxTermux container — base package set.
#
# One package per line; '#' comments and blank lines ignored. seed.sh tries the
# whole list in one `pkg install`, then falls back to a per-package loop so a
# single package missing on one ABI does not fail the whole image build.

# shell + core
bash
bash-completion
coreutils
sed
grep
gawk
findutils
file
which

# transfer / vcs
curl
wget
git
openssh
rsync
ca-certificates

# terminal UX (parity with the app's extras-keys workflow)
less
nano
vim
tmux
htop
procps
jq
tree
ncdu

# archive / build basics
tar
unzip
zip
xz-utils

# python: many tools and the AI CLIs' helper scripts expect it.
# Note: Termux `python` Recommends python-pip, which the seed does NOT install
# (--no-install-recommends): pip's _vendor/urllib3, _vendor/setuptools and
# _vendor/msgpack are the source of every pypi CVE an image scan reports, and
# Termux has no fixed build. Nothing seeded uses pip. `pkg install python-pip`
# still works on demand.
python

# Termux:API command line tools. The CLIs install and list normally but any
# call broadcasts an Android intent, so they fail inside a container exactly
# like they do on a device without the plugin APK installed.
termux-api

# JS runtime. bun is the primary tool (installed by seed.sh); nodejs-lts is
# only needed on ABIs where bun has no build (arm/i686).
# Note: nodejs-lts Recommends npm, which the seed does NOT install
# (--no-install-recommends): npm's bundled node_modules (undici, ip-address,
# brace-expansion, ...) are the source of every npm CVE an image scan reports,
# and Termux has no fixed build. Nothing seeded uses npm -- `bun x --bun` runs
# npx without it. `pkg install npm` still works on demand.
nodejs-lts
