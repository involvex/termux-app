#!/data/data/com.involvex.termux_app/files/usr/bin/bash
# invapp-resource: td-kilo-setup
# KiloCode CLI installer for InVxTermux
# Downloads official linux-arm64 binary from GitHub releases.
# Uses glibc + DNS shim via ld-linux (mirrors opencode-setup pattern).
set -e
PREFIX="${PREFIX:-/data/data/com.involvex.termux_app/files/usr}"
HOME="${HOME:-/data/data/com.involvex.termux_app/files/home}"
export PATH="$PREFIX/bin:$PATH"
export LD_LIBRARY_PATH="$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export TMPDIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMPDIR"
REDIRECTOR_SO="$PREFIX/lib/libinvapp-redirector.so"
[ -f "$REDIRECTOR_SO" ] && export LD_PRELOAD="$REDIRECTOR_SO${LD_PRELOAD:+:$LD_PRELOAD}"

KILOCODE_DIR="$PREFIX/libexec/kilocode"
KILOCODE_BIN="$KILOCODE_DIR/kilo"
KILOCODE_VERSION_FILE="$PREFIX/var/lib/invapp/kilo.version"
FALLBACK_VERSION="v1.0.0"

# Load commons if available
if [ -f "$PREFIX/lib/invapp/bootstrap.sh" ] && [ -f "$PREFIX/lib/invapp/commons.sh" ]; then
  . "$PREFIX/lib/invapp/bootstrap.sh"
  import "@/commons"
else
  D_CYAN=$'\e[0;36m'
  D_GREEN=$'\e[0;32m'
  D_RED=$'\e[0;31m'
  D_YELLOW=$'\e[0;33m'
  D_NC=$'\e[0;37m'
  GRAY=$'\e[0;90m'
  GREEN=$'\e[1;32m'
  CYAN=$'\e[1;36m'
  RED=$'\e[1;31m'
  YELLOW=$'\e[1;33m'
  NC=$'\e[1;37m'
  log_info()    { echo -e "    ${CYAN}>>${D_CYAN} $*${D_NC}"; }
  log_success() { echo -e "    ${GREEN}OK${D_GREEN} $*${D_NC}"; }
  log_warn()    { echo -e "    ${YELLOW}!!${D_YELLOW} $*${D_NC}"; }
  log_error()   { echo -e "    ${RED}ERR${D_RED} $*${D_NC}" >&2; }
  list_item()   { echo -e "    ${GRAY}*${D_NC} $*"; }
  box() { echo -e "${GRAY}== $1 ==${NC}"; }
  loading() { "$@"; }
fi

_arch_tag() {
  case "$(uname -m)" in
    aarch64|arm64) echo "arm64" ;;
    x86_64|amd64)  echo "x64"   ;;
    *)             echo "arm64" ;;
  esac
}

_glibc_loader() {
  local arch="$(_arch_tag)"
  if [ "$arch" = "x64" ]; then
    echo "$PREFIX/glibc/lib/ld-linux-x86-64.so.2"
  else
    echo "$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
  fi
}

_needs_glibc() {
  [ ! -f "$PREFIX/glibc/lib/libc.so.6" ]
}

_install_glibc() {
  log_info "Installing glibc (linux binaries need it on Android)"
  yes | pkg install glibc-repo 2>&1 | tail -1
  yes | pkg install glibc 2>&1 | tail -1
  log_success "glibc installed"
}

_get_latest_kilo_version() {
  curl -fsSL "https://api.github.com/repos/Kilo-Org/kilocode/releases/latest" 2>/dev/null |
    grep '"tag_name":' | sed -E 's/.*\"([^\"]+)\".*/\1/' | head -1
}

_needs_deps() {
  for dep in git rg node; do command -v "$dep" >/dev/null 2>&1 || return 0; done
  return 1
}

_install_deps() {
  log_info "Installing dependencies (git, ripgrep, nodejs)"
  yes | pkg install git ripgrep nodejs-lts 2>&1 | tail -3 || true
}

_install_kilo_native() {
  if _needs_glibc; then
    _install_glibc || exit 1
  fi

  if _needs_deps; then
    _install_deps
  fi

  local ver="${KILOCODE_VERSION:-}"
  if [ -z "$ver" ]; then
    ver="$(_get_latest_kilo_version)"
    if [ -z "$ver" ]; then
      log_warn "Could not fetch latest version, using $FALLBACK_VERSION"
      ver="$FALLBACK_VERSION"
    fi
  fi
  log_info "KiloCode version: $ver"

  local arch="$(_arch_tag)"
  local tarball="kilo-linux-${arch}.tar.gz"
  local url="https://github.com/Kilo-Org/kilocode/releases/download/${ver}/${tarball}"

  log_info "Downloading $tarball"
  rm -rf "${KILOCODE_DIR}.tmp"
  mkdir -p "${KILOCODE_DIR}.tmp"
  local tmp_tar="$TMPDIR/$tarball"
  if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 -o "$tmp_tar" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -O "$tmp_tar" "$url"
  else
    log_error "Need curl or wget"
    return 1
  fi

  log_info "Extracting"
  tar -xzf "$tmp_tar" -C "${KILOCODE_DIR}.tmp" 2>/dev/null
  rm -f "$tmp_tar"

  local found
  found=$(find "${KILOCODE_DIR}.tmp" -type f -name 'kilo' 2>/dev/null | head -1)
  if [ -z "$found" ]; then
    log_error "Tarball did not contain kilo binary"
    rm -rf "${KILOCODE_DIR}.tmp"
    return 1
  fi

  rm -rf "$KILOCODE_DIR"
  mkdir -p "$KILOCODE_DIR"
  cp "$found" "$KILOCODE_BIN"
  chmod +x "$KILOCODE_BIN"
  rm -rf "${KILOCODE_DIR}.tmp"

  mkdir -p "$(dirname "$KILOCODE_VERSION_FILE")"
  echo "$ver" > "$KILOCODE_VERSION_FILE"

  log_success "KiloCode CLI installed"
  echo
  list_item "Version:  $ver"
  list_item "Binary:   $KILOCODE_BIN"
  list_item "Command:  kilo / kilocode"
  echo
}

KILOCODE_VERSION=""
FORCE_REINSTALL=0

echo ""
box "KiloCode CLI Setup"
echo

while [ $# -gt 0 ]; do
  case "$1" in
    --version) KILOCODE_VERSION="${2:-}"; shift 2 ;;
    --version=*) KILOCODE_VERSION="${1#--version=}"; shift ;;
    --reinstall) FORCE_REINSTALL=1; shift ;;
    -h|--help)
      echo "Usage: td-kilo-setup [--version V] [--reinstall]"
      echo "  --version V   Pin version (default: latest GitHub release)"
      echo "  --reinstall   Force reinstall"
      exit 0 ;;
    *) echo "Unknown: $1" >&2; exit 2 ;;
  esac
done

if [ "$FORCE_REINSTALL" -eq 0 ] && [ -x "$KILOCODE_BIN" ] && [ -f "$(_glibc_loader)" ]; then
  log_success "KiloCode CLI already installed"
  list_item "Binary: $KILOCODE_BIN"
  if [ -f "$KILOCODE_VERSION_FILE" ]; then
    list_item "Version: $(cat "$KILOCODE_VERSION_FILE")"
  fi
  list_item "Run: kilo --help"
  exit 0
fi

if _needs_glibc; then
  log_warn "glibc not installed (required)"
  log_info "Run: pkg install glibc"
  exit 1
fi

_install_kilo_native
echo
log_info "Done. Run: kilo"
echo
