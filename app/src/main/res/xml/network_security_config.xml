<network-security-config>
    <!--
      Preview WebView may load any http(s) URL (LAN IPs, tunnels, public hosts).
      Domain-config cannot list arbitrary IPs, so cleartext is permitted app-wide.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
