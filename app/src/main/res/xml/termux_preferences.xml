<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        app:title="@string/termux_debugging_preferences_title"
        app:summary="@string/termux_debugging_preferences_summary"
        app:fragment="com.invapp.app.fragments.settings.termux.DebuggingPreferencesFragment"/>

    <Preference
        app:title="@string/termux_terminal_io_preferences_title"
        app:summary="@string/termux_terminal_io_preferences_summary"
        app:fragment="com.invapp.app.fragments.settings.termux.TerminalIOPreferencesFragment"/>

    <Preference
        app:title="@string/termux_terminal_view_preferences_title"
        app:summary="@string/termux_terminal_view_preferences_summary"
        app:fragment="com.invapp.app.fragments.settings.termux.TerminalViewPreferencesFragment"/>

    <Preference
        app:key="customize_extra_keys"
        app:title="@string/title_settings_customize_extra_keys"
        app:summary="@string/summary_settings_customize_extra_keys"
        app:persistent="false"/>

    <Preference
        app:key="widget_scripts"
        app:title="@string/title_widget_scripts"
        app:summary="@string/summary_widget_scripts"
        app:persistent="false"/>

    <Preference
        app:key="preferred_ports"
        app:title="@string/title_preferred_ports"
        app:summary="@string/summary_preferred_ports"
        app:persistent="false"/>

    <SwitchPreferenceCompat
        app:key="notify_preferred_ports"
        app:title="@string/title_notify_preferred_ports"
        app:summary="@string/summary_notify_preferred_ports"
        app:defaultValue="true"
        app:persistent="false"/>

    <SwitchPreferenceCompat
        app:key="preview_show_console"
        app:title="@string/title_preview_show_console"
        app:summary="@string/summary_preview_show_console"
        app:defaultValue="false"
        app:persistent="false"/>

    <SwitchPreferenceCompat
        app:key="preview_desktop_ua"
        app:title="@string/title_preview_desktop_ua"
        app:summary="@string/summary_preview_desktop_ua"
        app:defaultValue="false"
        app:persistent="false"/>

    <Preference
        app:key="bun"
        app:title="@string/title_bun"
        app:summary="@string/summary_bun"
        app:persistent="false"
        app:fragment="com.invapp.app.fragments.settings.BunPreferencesFragment"/>

    <Preference
        app:key="ai_doctor"
        app:title="@string/title_ai_doctor"
        app:summary="@string/summary_ai_doctor"
        app:persistent="false"
        app:fragment="com.invapp.app.fragments.settings.AiPreferencesFragment"/>

    <Preference
        app:key="integrated_tools"
        app:title="@string/title_integrated_tools"
        app:summary="@string/summary_integrated_tools"
        app:persistent="false"
        app:fragment="com.invapp.app.fragments.settings.IntegratedToolsPreferencesFragment"/>

    <Preference
        app:key="backup"
        app:title="@string/title_backup"
        app:summary="@string/summary_backup"
        app:persistent="false"
        app:fragment="com.invapp.app.fragments.settings.BackupPreferencesFragment"/>

    <ListPreference
        app:key="launch_page"
        app:title="@string/title_launch_page"
        app:summary="@string/summary_launch_page"
        app:persistent="false"/>

    <SwitchPreferenceCompat
        app:key="auto_start_console"
        app:title="@string/title_auto_start_console"
        app:summary="@string/summary_auto_start_console"
        app:persistent="false"/>

</PreferenceScreen>
