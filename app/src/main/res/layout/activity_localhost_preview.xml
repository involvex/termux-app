<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/preview_port_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_localhost_port"
            android:inputType="textUri"
            android:maxLength="256"
            android:selectAllOnFocus="true"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/preview_go_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_preview_go" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/preview_back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_back" />

            <Button
                android:id="@+id/preview_forward_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_forward" />

            <Button
                android:id="@+id/preview_reload_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_reload" />

            <Button
                android:id="@+id/preview_scan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_scan" />

            <Button
                android:id="@+id/preview_copy_lan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_copy_lan" />

            <Button
                android:id="@+id/preview_clear_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_clear_data" />

            <Button
                android:id="@+id/preview_browser_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_open_browser" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/preview_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/preview_lan_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/preview_port_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/preview_ports_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:text="@string/msg_preview_no_ports"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/preview_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/preview_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/preview_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
