<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/preview_port_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_localhost_port"
            android:contentDescription="@string/desc_preview_port_input"
            android:inputType="textUri"
            android:maxLength="256"
            android:selectAllOnFocus="true"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/preview_go_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_preview_go"
            android:contentDescription="@string/desc_preview_go" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/preview_back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_back"
                android:contentDescription="@string/desc_preview_back" />

            <Button
                android:id="@+id/preview_forward_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_forward"
                android:contentDescription="@string/desc_preview_forward" />

            <Button
                android:id="@+id/preview_reload_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_reload"
                android:contentDescription="@string/desc_preview_reload" />

            <Button
                android:id="@+id/preview_scan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_scan"
                android:contentDescription="@string/desc_preview_scan" />

            <Button
                android:id="@+id/preview_copy_lan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_copy_lan"
                android:contentDescription="@string/desc_preview_copy_lan" />

            <Button
                android:id="@+id/preview_qr_lan_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_show_qr"
                android:contentDescription="@string/desc_preview_qr_lan" />

            <Button
                android:id="@+id/preview_clear_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_clear_data"
                android:contentDescription="@string/desc_preview_clear" />

            <Button
                android:id="@+id/preview_browser_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_preview_open_browser"
                android:contentDescription="@string/desc_preview_browser" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/preview_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/preview_lan_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/preview_port_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/preview_ports_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp"
        android:text="@string/msg_preview_no_ports"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/preview_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/preview_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/preview_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/preview_console_panel"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#1a1a1a">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/title_preview_console"
                android:textColor="#9f9"
                android:textSize="12sp" />

            <Button
                android:id="@+id/preview_console_clear_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text="@string/action_preview_console_clear"
                android:contentDescription="@string/action_preview_console_clear"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/preview_console_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <TextView
                android:id="@+id/preview_console_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:textColor="#ccc"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
